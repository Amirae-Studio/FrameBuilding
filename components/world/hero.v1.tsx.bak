/**
 * Hero — a heritage city at dusk, seen straight down its river.
 *
 *  HeroSky     (slow parallax layer)  sky, sun glow, big low-poly peaks, cloud banks
 *  HeroStreet  (main world layer)     near peaks + falls, towers, river, lamps, rocks
 *
 * World units: 1600 wide; the hero occupies y 0 – 1016. Pure SVG, seeded,
 * so server and client render identically.
 */
import type { ReactNode } from "react";

type P = [number, number];

function rng(seed: number) {
  let a = seed >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) >>> 0;
    let t = a;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
/** round to 0.1 so server and browser serialise identical attributes */
const q = (n: number) => Math.round(n * 10) / 10;
const pts = (ps: P[]) => ps.map((p) => `${p[0].toFixed(1)},${p[1].toFixed(1)}`).join(" ");

/** river bank / promenade line: y of the railing at x (lower at the edges) */
const BANK_EDGE = 872;
const BANK_MID = 812;
const bankY = (x: number) => lerp(BANK_MID, BANK_EDGE, Math.min(1, Math.abs(x - 800) / 800));

/* ------------------------------------------------------------------ defs */

function HeroDefs() {
  return (
    <defs>
      <linearGradient id="hh-sky" gradientUnits="userSpaceOnUse" x1="0" y1="-200" x2="0" y2="980">
        <stop offset="0" stopColor="#3f2c78" />
        <stop offset="0.22" stopColor="#6a4c9c" />
        <stop offset="0.45" stopColor="#a86fae" />
        <stop offset="0.62" stopColor="#e38f9a" />
        <stop offset="0.78" stopColor="#f8b083" />
        <stop offset="1" stopColor="#ffd39a" />
      </linearGradient>
      <radialGradient id="hh-sun" gradientUnits="userSpaceOnUse" cx="800" cy="640" r="620">
        <stop offset="0" stopColor="#fff0c8" stopOpacity="0.9" />
        <stop offset="0.3" stopColor="#ffc189" stopOpacity="0.55" />
        <stop offset="1" stopColor="#ff9a8a" stopOpacity="0" />
      </radialGradient>
      <linearGradient id="hh-haze" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stopColor="#f6b9c4" stopOpacity="0" />
        <stop offset="1" stopColor="#f6b9c4" stopOpacity="0.75" />
      </linearGradient>
      <linearGradient id="hh-cloud" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stopColor="#fff1f6" />
        <stop offset="0.55" stopColor="#f2cfe4" />
        <stop offset="1" stopColor="#c3a0d8" />
      </linearGradient>
      <linearGradient id="hh-cloud-dusk" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stopColor="#ffd9cf" />
        <stop offset="1" stopColor="#b48ccc" />
      </linearGradient>
      <linearGradient id="hh-river" gradientUnits="userSpaceOnUse" x1="0" y1="800" x2="0" y2="1016">
        <stop offset="0" stopColor="#fbf3ff" />
        <stop offset="0.25" stopColor="#c9d6ff" />
        <stop offset="0.6" stopColor="#86a0f0" />
        <stop offset="1" stopColor="#5b62c8" />
      </linearGradient>
      <linearGradient id="hh-bank" gradientUnits="userSpaceOnUse" x1="0" y1="800" x2="0" y2="1016">
        <stop offset="0" stopColor="#5a3a8a" />
        <stop offset="1" stopColor="#24164d" />
      </linearGradient>
      <linearGradient id="hh-cone" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stopColor="#fff6c8" stopOpacity="1" />
        <stop offset="0.45" stopColor="#ffdc7e" stopOpacity="0.78" />
        <stop offset="1" stopColor="#ffc46b" stopOpacity="0.22" />
      </linearGradient>
      <linearGradient id="hh-fall" x1="0" x2="1">
        <stop offset="0" stopColor="#c8d4ff" stopOpacity="0.4" />
        <stop offset="0.5" stopColor="#ffffff" />
        <stop offset="1" stopColor="#c8d4ff" stopOpacity="0.4" />
      </linearGradient>
      {/* building faces */}
      <linearGradient id="hh-b-glow" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stopColor="#ffbf73" />
        <stop offset="0.45" stopColor="#e47a6e" />
        <stop offset="1" stopColor="#6d3a86" />
      </linearGradient>
      <linearGradient id="hh-b-warm" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stopColor="#c86a7c" />
        <stop offset="1" stopColor="#4c2f80" />
      </linearGradient>
      <linearGradient id="hh-b-cool" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stopColor="#4d3f96" />
        <stop offset="1" stopColor="#261b58" />
      </linearGradient>
      <linearGradient id="hh-b-dark" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stopColor="#3a2c6c" />
        <stop offset="1" stopColor="#1b1342" />
      </linearGradient>
      <linearGradient id="hh-b-side" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stopColor="#ff9f74" stopOpacity="0.9" />
        <stop offset="1" stopColor="#7a3f8a" stopOpacity="0.9" />
      </linearGradient>
    </defs>
  );
}

/* ------------------------------------------------------- low-poly peaks */

const LIGHT = ["#e2c3ee", "#d3afe6", "#e9d0f3", "#c9a2df", "#dcb9ea"];
const DARK = ["#8d66bb", "#7b57ad", "#9670c3", "#6f4ca1", "#8560b4"];

/**
 * Low-poly mountain: a lit left flank and a shaded right flank, each split
 * into facets between the ridge and a central spine.
 */
function Peak({
  peak,
  left,
  right,
  base,
  seed,
  snow = true,
  light = LIGHT,
  dark = DARK,
}: {
  peak: P;
  left: number;
  right: number;
  base: number;
  seed: number;
  snow?: boolean;
  light?: string[];
  dark?: string[];
}) {
  const r = rng(seed);
  const n = 5;
  const spineEnd = peak[0] + (r() - 0.5) * 60;
  const spine: P[] = [];
  const L: P[] = [];
  const R: P[] = [];
  for (let i = 0; i <= n; i++) {
    const t = i / n;
    const ease = Math.pow(t, 0.85);
    spine.push([lerp(peak[0], spineEnd, t) + (i && i < n ? (r() - 0.5) * 30 : 0), lerp(peak[1], base, t)]);
    L.push([lerp(peak[0], left, ease) + (i && i < n ? (r() - 0.5) * 40 : 0), lerp(peak[1], base, t) + (i && i < n ? (r() - 0.5) * 30 : 0)]);
    R.push([lerp(peak[0], right, ease) + (i && i < n ? (r() - 0.5) * 40 : 0), lerp(peak[1], base, t) + (i && i < n ? (r() - 0.5) * 30 : 0)]);
  }
  const faces: ReactNode[] = [];
  for (let i = 0; i < n; i++) {
    const lc = light[Math.floor(r() * light.length)];
    const lc2 = light[Math.floor(r() * light.length)];
    const dc = dark[Math.floor(r() * dark.length)];
    const dc2 = dark[Math.floor(r() * dark.length)];
    faces.push(
      <polygon key={`l${i}a`} points={pts([L[i], L[i + 1], spine[i + 1]])} fill={lc} />,
      <polygon key={`l${i}b`} points={pts([L[i], spine[i + 1], spine[i]])} fill={lc2} />,
      <polygon key={`r${i}a`} points={pts([R[i], spine[i], spine[i + 1]])} fill={dc} />,
      <polygon key={`r${i}b`} points={pts([R[i], spine[i + 1], R[i + 1]])} fill={dc2} />
    );
  }
  return (
    <g>
      {faces}
      {snow && (
        <>
          <polygon points={pts([peak, L[1], [lerp(L[1][0], spine[1][0], 0.5), spine[1][1] + 6], spine[1]])} fill="#f7ebfb" opacity="0.85" />
          <polygon points={pts([peak, spine[1], [lerp(spine[1][0], R[1][0], 0.4), R[1][1] - 4]])} fill="#c8a8e4" opacity="0.8" />
        </>
      )}
    </g>
  );
}

/* --------------------------------------------------------------- clouds */

/** A puffy cumulus bank: shaded puffs with a flat underside. */
function CloudBank({
  x,
  y,
  w,
  seed,
  scale = 1,
  fill = "url(#hh-cloud)",
  drift = 0,
  opacity = 0.95,
}: {
  x: number;
  y: number;
  w: number;
  seed: number;
  scale?: number;
  fill?: string;
  drift?: number;
  opacity?: number;
}) {
  const r = rng(seed);
  const puffs: ReactNode[] = [];
  let cx = x;
  let i = 0;
  while (cx < x + w) {
    const t = (cx - x) / w;
    const hump = Math.sin(t * Math.PI); // taller in the middle
    const rad = (18 + r() * 26 + hump * 34) * scale;
    puffs.push(<circle key={i++} cx={q(cx)} cy={q(y - rad * 0.45)} r={q(rad)} fill={fill} />);
    cx += rad * (0.75 + r() * 0.4);
  }
  return (
    <g opacity={opacity}>
      <g
        className={drift ? "hb-drift" : undefined}
        style={drift ? { animationDuration: `${drift}s`, animationDelay: `${-(x % 9)}s` } : undefined}
      >
        {puffs}
        <rect x={x - 20 * scale} y={y - 6 * scale} width={w + 40 * scale} height={10 * scale} rx={5 * scale} fill="#c3a0d8" opacity="0.9" />
      </g>
    </g>
  );
}

/* ------------------------------------------------------------- HeroSky */

/** Sky, sun glow, the two great peaks and high clouds — slow parallax. */
export function HeroSky() {
  return (
    <g>
      <HeroDefs />
      <rect x="-200" y="-2400" width="2000" height="2300" fill="#3f2c78" />
      <rect x="-200" y="-200" width="2000" height="1300" fill="url(#hh-sky)" />
      <rect className="hb-breathe" x="-200" y="0" width="2000" height="1100" fill="url(#hh-sun)" />

      {/* thin high clouds */}
      {[
        [120, 150, 260],
        [1180, 120, 300],
        [700, 230, 200],
      ].map(([x, y, w], i) => (
        <g key={i} className="hb-drift" style={{ animationDuration: `${44 + i * 9}s` }}>
          <ellipse cx={x + w / 2} cy={y} rx={w / 2} ry="7" fill="#f6cfe2" opacity="0.5" />
        </g>
      ))}

      {/* the two great peaks behind the title */}
      <Peak peak={[400, 130]} left={-170} right={930} base={900} seed={3} />
      <Peak peak={[1200, 150]} left={700} right={1830} base={900} seed={8} />
      {/* shoulder peaks */}
      <Peak peak={[90, 330]} left={-220} right={360} base={900} seed={14} snow={false} />
      <Peak peak={[1500, 300]} left={1240} right={1820} base={900} seed={21} snow={false} />

      <rect x="-200" y="420" width="2000" height="300" fill="url(#hh-haze)" />

      {/* cloud banks wrapped around the peaks */}
      <CloudBank x={-60} y={500} w={520} seed={31} drift={48} />
      <CloudBank x={980} y={470} w={560} seed={37} drift={56} />
      <CloudBank x={420} y={560} w={420} seed={41} scale={0.8} drift={40} fill="url(#hh-cloud-dusk)" />
      <rect x="-200" y="560" width="2000" height="560" fill="#e8a6b6" opacity="0.35" />
    </g>
  );
}

/* ------------------------------------------------------------ towers */

type Tone = "glow" | "warm" | "cool" | "dark";

/** A city block seen face-on, with a sliver of its river-facing side. */
function Tower({
  x0,
  x1,
  top,
  tone,
  seed,
  side,
  roof = "flat",
}: {
  x0: number;
  x1: number;
  top: number;
  tone: Tone;
  seed: number;
  side: -1 | 1;
  roof?: "flat" | "step" | "spire" | "crown";
}) {
  const r = rng(seed);
  const base = bankY((x0 + x1) / 2) + 6;
  const w = x1 - x0;
  // nearness: 1 at the frame edge, 0 by the river's far end
  const near = Math.min(1, Math.abs((x0 + x1) / 2 - 800) / 760);
  const ww = 5 + near * 9;
  const wh = 7 + near * 10;
  const gx = ww * 0.9;
  const gy = wh * 0.75;
  const cols = Math.max(2, Math.floor((w - gx) / (ww + gx)));
  const padX = (w - (cols * ww + (cols - 1) * gx)) / 2;

  const wins: ReactNode[] = [];
  let row = 0;
  for (let y = top + 18 + near * 10; y + wh < base - 12; y += wh + gy, row++) {
    for (let c = 0; c < cols; c++) {
      const lit = r() < (tone === "glow" ? 0.6 : 0.38);
      const tw = lit && r() > 0.82;
      wins.push(
        <rect
          key={`${row}-${c}`}
          className={tw ? "hb-twinkle" : undefined}
          style={tw ? { animationDelay: `${(r() * 9).toFixed(1)}s`, animationDuration: `${(6 + r() * 6).toFixed(1)}s` } : undefined}
          x={x0 + padX + c * (ww + gx)}
          y={y}
          width={ww}
          height={wh}
          fill={lit ? (r() < 0.5 ? "#ffd27a" : "#ffb35c") : tone === "glow" ? "#8a3f6e" : "#21184c"}
          opacity={lit ? 0.95 : 0.85}
        />
      );
    }
  }

  // river-facing side face, receding toward the vanishing point
  const edge = side < 0 ? x1 : x0;
  const depth = (800 - edge) * 0.07;
  const sideFace: P[] = [
    [edge, top],
    [edge + depth, top + Math.abs(depth) * 0.35],
    [edge + depth, base - 2],
    [edge, base],
  ];

  return (
    <g>
      <polygon points={pts(sideFace)} fill="url(#hh-b-side)" />
      <rect x={x0} y={top} width={w} height={base - top} fill={`url(#hh-b-${tone})`} />
      {/* sunlit edge facing the river */}
      <rect x={side < 0 ? x1 - 3 : x0} y={top} width="3" height={base - top} fill="#ffc48a" opacity="0.7" />
      {/* cornice + floor bands */}
      <rect x={x0 - 2} y={top} width={w + 4} height={4 + near * 4} fill="#2a1d55" />
      {wins}
      {roof === "step" && <rect x={x0 + w * 0.2} y={top - 24 - near * 20} width={w * 0.6} height={24 + near * 20} fill={`url(#hh-b-${tone})`} />}
      {roof === "spire" && (
        <>
          <rect x={x0 + w * 0.35} y={top - 30} width={w * 0.3} height="30" fill="#2a1d55" />
          <line x1={x0 + w / 2} y1={top - 30} x2={x0 + w / 2} y2={top - 70 - near * 30} stroke="#2a1d55" strokeWidth="3" />
          <circle className="hb-flicker" cx={x0 + w / 2} cy={top - 70 - near * 30} r="3" fill="#ff7a7a" />
        </>
      )}
      {roof === "crown" && (
        <polygon
          points={pts([
            [x0 - 4, top],
            [x0 + w * 0.12, top - 18 - near * 12],
            [x1 - w * 0.12, top - 18 - near * 12],
            [x1 + 4, top],
          ])}
          fill="#3a2a70"
        />
      )}
    </g>
  );
}

/* ---------------------------------------------------------------- lamps */

function Lamp({ x, h, k }: { x: number; h: number; k: number }) {
  const yb = bankY(x) - 2;
  const yh = yb - h;
  const spread = 20 + 46 * k;
  return (
    <g>
      <polygon
        className="hb-flicker"
        style={{ animationDelay: `${((x * 13) % 70) / 10}s` }}
        points={pts([
          [x - 3, yh],
          [x + 3, yh],
          [x + spread, yb],
          [x - spread, yb],
        ])}
        fill="url(#hh-cone)"
      />
      <line x1={x} y1={yb} x2={x} y2={yh - 4} stroke="#2a1d4f" strokeWidth={1.5 + k * 2.5} />
      <rect x={x - 3 - k * 3} y={yh - 4 - k * 4} width={6 + k * 6} height={4 + k * 4} rx="1" fill="#2a1d4f" />
      <circle cx={x} cy={yh + 1} r={2 + k * 2} fill="#fff4c4" />
    </g>
  );
}

/* --------------------------------------------------------------- rocks */

function Boulder({ cx, cy, w, h, seed, tone = 0 }: { cx: number; cy: number; w: number; h: number; seed: number; tone?: number }) {
  const r = rng(seed);
  const pal = [
    ["#8a4f9a", "#cf86c4", "#4f2b76"],
    ["#7b4697", "#b97cc4", "#4b2a76"],
    ["#9a5aa2", "#e09bcd", "#5a3180"],
  ][tone % 3];
  const P0: P[] = [];
  const n = 8;
  for (let i = 0; i < n; i++) {
    const a = Math.PI + (i / (n - 1)) * Math.PI;
    const j = 0.82 + r() * 0.3;
    P0.push([cx + (Math.cos(a) * w) / 2 * j, cy + Math.sin(a) * h * j]);
  }
  const body: P[] = [...P0, [cx + w / 2, cy + h * 0.35], [cx - w / 2, cy + h * 0.35]];
  const top: P[] = [P0[1], P0[2], P0[3], P0[4], [cx + w * 0.06, cy - h * 0.3], [cx - w * 0.2, cy - h * 0.12]];
  const shade: P[] = [P0[5], P0[6], P0[7], [cx + w / 2, cy + h * 0.35], [cx + w * 0.1, cy + h * 0.15]];
  return (
    <g>
      <polygon points={pts(body)} fill={pal[0]} />
      <polygon points={pts(top)} fill={pal[1]} opacity="0.9" />
      <polygon points={pts(shade)} fill={pal[2]} opacity="0.75" />
    </g>
  );
}

/* ------------------------------------------------------------ HeroStreet */

const LEFT: Array<[number, number, number, Tone, "flat" | "step" | "spire" | "crown"]> = [
  // x0, x1, top, tone, roof — far (by the river) to near (frame edge)
  [690, 742, 660, "dark", "flat"],
  [640, 700, 625, "cool", "crown"],
  [585, 650, 590, "dark", "flat"],
  [520, 595, 560, "warm", "step"],
  [440, 530, 530, "dark", "flat"],
  [360, 450, 485, "cool", "crown"],
  [280, 372, 450, "dark", "flat"],
  [180, 292, 470, "cool", "step"],
  [90, 196, 300, "dark", "spire"],
  [-30, 104, 232, "glow", "flat"],
];
const RIGHT: Array<[number, number, number, Tone, "flat" | "step" | "spire" | "crown"]> = [
  [858, 905, 665, "dark", "flat"],
  [895, 950, 632, "cool", "flat"],
  [940, 1000, 580, "dark", "crown"],
  [990, 1060, 570, "cool", "step"],
  [1050, 1125, 510, "warm", "flat"],
  [1115, 1205, 460, "dark", "spire"],
  [1195, 1275, 480, "cool", "flat"],
  [1265, 1420, 490, "warm", "crown"],
  [1405, 1640, 282, "glow", "flat"],
];

export function HeroStreet({ spill }: { spill: [number, number] }) {
  const r = rng(77);
  const [s0, s1] = spill;

  // rapids — foam lines across the river, wider as they near us
  const rapids = Array.from({ length: 16 }).map((_, i) => {
    const t = (i + 0.5) / 16;
    const y = lerp(820, 1005, t * t * 0.4 + t * 0.6);
    const half = lerp(28, 300, (y - 806) / 210);
    const x = 800 + (r() - 0.5) * half * 0.8;
    const len = half * (0.35 + r() * 0.5);
    return (
      <path
        key={i}
        className="hb-foam"
        style={{ animationDelay: `${(-r() * 4).toFixed(1)}s`, animationDuration: `${(2.6 + r() * 2).toFixed(1)}s` }}
        d={`M${x - len / 2},${y} q${len / 4},${-4 - t * 6} ${len / 2},0 t${len / 2},0`}
        stroke="#ffffff"
        strokeWidth={1.2 + t * 3}
        fill="none"
        strokeLinecap="round"
        opacity={0.75}
      />
    );
  });

  // promenade railing along each bank
  const railing = (from: number, to: number) => {
    const posts: ReactNode[] = [];
    const step = 16;
    for (let x = from; from < to ? x <= to : x >= to; x += from < to ? step : -step) {
      const y = bankY(x);
      const h = 8 + (Math.abs(x - 800) / 800) * 12;
      posts.push(<line key={x} x1={x} y1={y} x2={x} y2={y - h} stroke="#2a1d4f" strokeWidth="1.6" />);
    }
    const hTo = 8 + (Math.abs(to - 800) / 800) * 12;
    const hFrom = 8 + (Math.abs(from - 800) / 800) * 12;
    return (
      <g>
        {posts}
        <line x1={from} y1={bankY(from) - hFrom} x2={to} y2={bankY(to) - hTo} stroke="#2a1d4f" strokeWidth="2.6" />
        <line x1={from} y1={bankY(from) - hFrom - 1.5} x2={to} y2={bankY(to) - hTo - 1.5} stroke="#ffbf86" strokeWidth="0.8" opacity="0.6" />
      </g>
    );
  };

  return (
    <g>
      {/* near peaks, the mountain falls, and the mist at their feet */}
      <Peak peak={[630, 400]} left={380} right={900} base={830} seed={51} />
      <Peak peak={[1040, 430]} left={830} right={1290} base={830} seed={57} snow={false} />
      <g>
        <rect x="574" y="470" width="16" height="150" fill="url(#hh-fall)" />
        {[578, 582, 586].map((x, i) => (
          <line key={x} className="hb-flow" style={{ animationDuration: `${1 + i * 0.3}s` }} x1={x} y1="470" x2={x} y2="620" stroke="#ffffff" strokeWidth="1.6" strokeDasharray="18 12" opacity="0.8" />
        ))}
      </g>
      <CloudBank x={250} y={560} w={420} seed={59} scale={1.1} drift={42} />
      <CloudBank x={960} y={540} w={420} seed={63} scale={1.15} drift={46} />
      <CloudBank x={600} y={690} w={400} seed={73} scale={1.1} drift={36} />
      <CloudBank x={430} y={735} w={340} seed={61} scale={0.9} drift={34} fill="url(#hh-cloud-dusk)" />
      <CloudBank x={840} y={745} w={330} seed={67} scale={0.85} drift={38} fill="url(#hh-cloud-dusk)" />
      <CloudBank x={560} y={790} w={480} seed={71} scale={0.7} drift={30} />

      {/* the source: a small fall feeding the river */}
      <rect x="786" y="742" width="28" height="70" fill="url(#hh-fall)" />
      {[791, 799, 807].map((x, i) => (
        <line key={x} className="hb-flow" style={{ animationDuration: `${1 + i * 0.25}s` }} x1={x} y1="742" x2={x} y2="812" stroke="#ffffff" strokeWidth="2.4" strokeDasharray="20 12" opacity="0.85" />
      ))}
      <ellipse className="hb-mist" cx="800" cy="812" rx="60" ry="9" fill="#ffffff" opacity="0.8" />

      {/* towers, far to near so the near ones overlap */}
      {LEFT.map(([a, b, t, tone, roof], i) => (
        <Tower key={`L${i}`} x0={a} x1={b} top={t} tone={tone} roof={roof} seed={100 + i} side={-1} />
      ))}
      {RIGHT.map(([a, b, t, tone, roof], i) => (
        <Tower key={`R${i}`} x0={a} x1={b} top={t} tone={tone} roof={roof} seed={200 + i} side={1} />
      ))}
      {/* warm light washing the near-left tower, as in the reference */}
      <rect x="-40" y="230" width="140" height="640" fill="#ffb36b" opacity="0.18" />

      {/* banks and river */}
      <polygon points={pts([[-50, bankY(-50)], [772, BANK_MID], [772, BANK_MID + 4], [470, 1016], [-50, 1016]])} fill="url(#hh-bank)" />
      <polygon points={pts([[1650, bankY(1650)], [828, BANK_MID], [828, BANK_MID + 4], [1130, 1016], [1650, 1016]])} fill="url(#hh-bank)" />
      <polygon points={pts([[772, 808], [828, 808], [1130, 1016], [470, 1016]])} fill="url(#hh-river)" />
      {/* stone embankment edges */}
      <line x1="772" y1="810" x2="470" y2="1016" stroke="#ffcfa0" strokeWidth="3" opacity="0.5" />
      <line x1="828" y1="810" x2="1130" y2="1016" stroke="#ffcfa0" strokeWidth="3" opacity="0.5" />
      {rapids}

      {/* street lamps along both promenades */}
      {[
        [40, 250, 1.1],
        [190, 210, 0.95],
        [370, 140, 0.62],
        [510, 100, 0.42],
        [590, 76, 0.3],
        [650, 58, 0.22],
        [700, 44, 0.15],
      ].map(([x, h, k]) => (
        <Lamp key={`ll${x}`} x={x} h={h} k={k} />
      ))}
      {[
        [910, 44, 0.15],
        [960, 56, 0.22],
        [1030, 74, 0.3],
        [1110, 96, 0.42],
        [1240, 130, 0.6],
        [1380, 180, 0.8],
        [1520, 230, 1.05],
      ].map(([x, h, k]) => (
        <Lamp key={`rl${x}`} x={x} h={h} k={k} />
      ))}
      {railing(-40, 764)}
      {railing(1640, 836)}

      {/* boulders in and along the river */}
      <Boulder cx={790} cy={850} w={34} h={10} seed={1} tone={2} />
      <Boulder cx={725} cy={900} w={60} h={18} seed={2} tone={1} />
      <Boulder cx={880} cy={915} w={70} h={20} seed={3} />
      <Boulder cx={600} cy={960} w={110} h={34} seed={4} tone={2} />
      <Boulder cx={975} cy={965} w={120} h={36} seed={5} tone={1} />
      <Boulder cx={150} cy={930} w={170} h={50} seed={21} tone={1} />
      <Boulder cx={330} cy={920} w={130} h={40} seed={22} />
      <Boulder cx={1270} cy={925} w={150} h={46} seed={23} tone={2} />
      <Boulder cx={1450} cy={935} w={180} h={54} seed={24} tone={1} />
      <Boulder cx={40} cy={1004} w={300} h={118} seed={6} />
      <Boulder cx={250} cy={1014} w={250} h={90} seed={7} tone={2} />
      <Boulder cx={430} cy={1004} w={210} h={74} seed={8} tone={1} />
      <Boulder cx={s0 - 50} cy={1008} w={120} h={42} seed={9} />
      <Boulder cx={s1 + 60} cy={1008} w={130} h={46} seed={10} tone={2} />
      <Boulder cx={1070} cy={1006} w={220} h={76} seed={11} tone={1} />
      <Boulder cx={1270} cy={1012} w={270} h={98} seed={12} />
      <Boulder cx={1490} cy={1000} w={310} h={120} seed={13} tone={2} />
      {/* foam where water breaks on the rocks */}
      {[
        [725, 896, 30],
        [880, 911, 34],
        [600, 952, 50],
        [975, 957, 54],
      ].map(([x, y, rx], i) => (
        <ellipse key={i} className="hb-mist" style={{ animationDelay: `${-i * 0.8}s` }} cx={x} cy={y + 8} rx={rx} ry="5" fill="#ffffff" opacity="0.7" />
      ))}
    </g>
  );
}
