/**
 * Hero — a heritage city at dusk, seen straight down its river.
 *
 *  HeroSky     (slow parallax layer)  sky, sun glow, big low-poly peaks, cloud banks
 *  HeroStreet  (main world layer)     near peaks + falls, towers, river, lamps, rocks
 *
 * World units: 1600 wide; the hero occupies y 0 – 1016. Pure SVG, seeded,
 * so server and client render identically.
 */
import type { ReactNode } from "react";

type P = [number, number];

function rng(seed: number) {
  let a = seed >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) >>> 0;
    let t = a;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
/** round to 0.1 so server and browser serialise identical attributes */
const q = (n: number) => Math.round(n * 10) / 10;
const pts = (ps: P[]) => ps.map((p) => `${p[0].toFixed(1)},${p[1].toFixed(1)}`).join(" ");


/* ------------------------------------------------------------------ defs */

function HeroDefs() {
  return (
    <defs>
      <linearGradient id="hh-sky" gradientUnits="userSpaceOnUse" x1="0" y1="-200" x2="0" y2="980">
        <stop offset="0" stopColor="#3f2c78" />
        <stop offset="0.22" stopColor="#6a4c9c" />
        <stop offset="0.45" stopColor="#a86fae" />
        <stop offset="0.62" stopColor="#e38f9a" />
        <stop offset="0.78" stopColor="#f8b083" />
        <stop offset="1" stopColor="#ffd39a" />
      </linearGradient>
      <radialGradient id="hh-sun" gradientUnits="userSpaceOnUse" cx="800" cy="640" r="620">
        <stop offset="0" stopColor="#fff0c8" stopOpacity="0.9" />
        <stop offset="0.3" stopColor="#ffc189" stopOpacity="0.55" />
        <stop offset="1" stopColor="#ff9a8a" stopOpacity="0" />
      </radialGradient>
      <linearGradient id="hh-haze" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stopColor="#f6b9c4" stopOpacity="0" />
        <stop offset="1" stopColor="#f6b9c4" stopOpacity="0.75" />
      </linearGradient>
      <linearGradient id="hh-cloud" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stopColor="#ffe6ea" />
        <stop offset="0.5" stopColor="#f3c4d6" />
        <stop offset="1" stopColor="#b88fcb" />
      </linearGradient>
      <linearGradient id="hh-cloud-dusk" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stopColor="#ffd2c4" />
        <stop offset="1" stopColor="#a77fc0" />
      </linearGradient>
      <linearGradient id="hh-river" gradientUnits="userSpaceOnUse" x1="0" y1="800" x2="0" y2="1016">
        <stop offset="0" stopColor="#fbf3ff" />
        <stop offset="0.25" stopColor="#c9d6ff" />
        <stop offset="0.6" stopColor="#86a0f0" />
        <stop offset="1" stopColor="#5b62c8" />
      </linearGradient>
      <linearGradient id="hh-bank" gradientUnits="userSpaceOnUse" x1="0" y1="800" x2="0" y2="1016">
        <stop offset="0" stopColor="#5a3a8a" />
        <stop offset="1" stopColor="#24164d" />
      </linearGradient>
      <linearGradient id="hh-cone" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stopColor="#fff6c8" stopOpacity="1" />
        <stop offset="0.45" stopColor="#ffdc7e" stopOpacity="0.78" />
        <stop offset="1" stopColor="#ffc46b" stopOpacity="0.22" />
      </linearGradient>
      <linearGradient id="hh-fall" x1="0" x2="1">
        <stop offset="0" stopColor="#c8d4ff" stopOpacity="0.4" />
        <stop offset="0.5" stopColor="#ffffff" />
        <stop offset="1" stopColor="#c8d4ff" stopOpacity="0.4" />
      </linearGradient>
      {/* street facades: plum stone, dark glass, rose brick */}
      <linearGradient id="hh-classic" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stopColor="#6e3d7e" />
        <stop offset="1" stopColor="#2c1f5e" />
      </linearGradient>
      <linearGradient id="hh-glass" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stopColor="#3d2f84" />
        <stop offset="1" stopColor="#1f1752" />
      </linearGradient>
      <linearGradient id="hh-brick" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stopColor="#8c4468" />
        <stop offset="1" stopColor="#3a2262" />
      </linearGradient>
      {/* facades warm up toward the sunset at the end of the street */}
      <linearGradient id="hh-sheenL" gradientUnits="userSpaceOnUse" x1="-90" y1="0" x2="820" y2="0">
        <stop offset="0" stopColor="#140d33" stopOpacity="0.45" />
        <stop offset="0.6" stopColor="#ff8f7a" stopOpacity="0.1" />
        <stop offset="1" stopColor="#ffb98a" stopOpacity="0.45" />
      </linearGradient>
      <linearGradient id="hh-sheenR" gradientUnits="userSpaceOnUse" x1="1690" y1="0" x2="820" y2="0">
        <stop offset="0" stopColor="#140d33" stopOpacity="0.45" />
        <stop offset="0.6" stopColor="#ff8f7a" stopOpacity="0.1" />
        <stop offset="1" stopColor="#ffb98a" stopOpacity="0.45" />
      </linearGradient>
      <linearGradient id="hh-reflect" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stopColor="#ffb08a" stopOpacity="0.9" />
        <stop offset="0.4" stopColor="#c9659c" stopOpacity="0.35" />
        <stop offset="1" stopColor="#2a1f66" stopOpacity="0" />
      </linearGradient>
      {/* viewer-facing fronts are backlit by the sky: deep and cool */}
      <linearGradient id="hh-front" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stopColor="#3a2a72" />
        <stop offset="1" stopColor="#1c1445" />
      </linearGradient>
      <linearGradient id="hh-dome" x1="0" x2="1">
        <stop offset="0" stopColor="#5a3389" />
        <stop offset="0.55" stopColor="#b35e9f" />
        <stop offset="1" stopColor="#ffab7d" />
      </linearGradient>
      <linearGradient id="hh-wash" x1="0" x2="1">
        <stop offset="0" stopColor="#ffb36b" stopOpacity="0.45" />
        <stop offset="1" stopColor="#ffb36b" stopOpacity="0" />
      </linearGradient>
      <filter id="hh-soft" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="6" />
      </filter>
      <filter id="hh-cloudsoft" x="-10%" y="-30%" width="120%" height="160%">
        <feGaussianBlur stdDeviation="3" />
      </filter>
    </defs>
  );
}

/* ------------------------------------------------------- low-poly peaks */

// soft dusk palette: pink-lilac lit flanks, violet shaded flanks
const LIGHT = ["#dcaad6", "#e6badd", "#d29fd1", "#ebc6e3", "#d8a6d6"];
const DARK = ["#8b5ba8", "#7c4f9d", "#9465ae", "#704794", "#8557a2"];
// nearer peaks sit deeper in the haze: a little darker and warmer
const LIGHT_P = ["#c98fc4", "#d69fcc", "#be86bd", "#ddaad2"];
const DARK_P = ["#774a96", "#6b4290", "#81539d", "#603c87"];

/**
 * Low-poly mountain: a lit left flank and a shaded right flank, each split
 * into facets between the ridge and a central spine.
 */
function Peak({
  peak,
  left,
  right,
  base,
  seed,
  snow = true,
  light = LIGHT,
  dark = DARK,
}: {
  peak: P;
  left: number;
  right: number;
  base: number;
  seed: number;
  snow?: boolean;
  light?: string[];
  dark?: string[];
}) {
  const r = rng(seed);
  const n = 5;
  const spineEnd = peak[0] + (r() - 0.5) * 60;
  const spine: P[] = [];
  const L: P[] = [];
  const R: P[] = [];
  for (let i = 0; i <= n; i++) {
    const t = i / n;
    const ease = Math.pow(t, 0.85);
    spine.push([lerp(peak[0], spineEnd, t) + (i && i < n ? (r() - 0.5) * 30 : 0), lerp(peak[1], base, t)]);
    L.push([lerp(peak[0], left, ease) + (i && i < n ? (r() - 0.5) * 40 : 0), lerp(peak[1], base, t) + (i && i < n ? (r() - 0.5) * 30 : 0)]);
    R.push([lerp(peak[0], right, ease) + (i && i < n ? (r() - 0.5) * 40 : 0), lerp(peak[1], base, t) + (i && i < n ? (r() - 0.5) * 30 : 0)]);
  }
  const faces: ReactNode[] = [];
  for (let i = 0; i < n; i++) {
    const lc = light[Math.floor(r() * light.length)];
    const lc2 = light[Math.floor(r() * light.length)];
    const dc = dark[Math.floor(r() * dark.length)];
    const dc2 = dark[Math.floor(r() * dark.length)];
    faces.push(
      <polygon key={`l${i}a`} points={pts([L[i], L[i + 1], spine[i + 1]])} fill={lc} />,
      <polygon key={`l${i}b`} points={pts([L[i], spine[i + 1], spine[i]])} fill={lc2} />,
      <polygon key={`r${i}a`} points={pts([R[i], spine[i], spine[i + 1]])} fill={dc} />,
      <polygon key={`r${i}b`} points={pts([R[i], spine[i + 1], R[i + 1]])} fill={dc2} />
    );
  }
  return (
    <g>
      {faces}
      {snow && (
        <>
          <polygon points={pts([peak, L[1], [lerp(L[1][0], spine[1][0], 0.5), spine[1][1] + 6], spine[1]])} fill="#f7dff0" opacity="0.8" />
          <polygon points={pts([peak, spine[1], [lerp(spine[1][0], R[1][0], 0.4), R[1][1] - 4]])} fill="#c49ad6" opacity="0.75" />
        </>
      )}
    </g>
  );
}

/* --------------------------------------------------------------- clouds */

/** A puffy cumulus bank: shaded puffs with a flat underside. */
function CloudBank({
  x,
  y,
  w,
  seed,
  scale = 1,
  fill = "url(#hh-cloud)",
  drift = 0,
  opacity = 0.95,
}: {
  x: number;
  y: number;
  w: number;
  seed: number;
  scale?: number;
  fill?: string;
  drift?: number;
  opacity?: number;
}) {
  const r = rng(seed);
  const puffs: ReactNode[] = [];
  let cx = x;
  let i = 0;
  while (cx < x + w) {
    const t = (cx - x) / w;
    const hump = Math.sin(t * Math.PI); // taller in the middle
    const rad = (18 + r() * 26 + hump * 34) * scale;
    puffs.push(<circle key={i++} cx={q(cx)} cy={q(y - rad * 0.45)} r={q(rad)} fill={fill} />);
    cx += rad * (0.75 + r() * 0.4);
  }
  return (
    <g opacity={opacity} filter="url(#hh-cloudsoft)">
      <g
        className={drift ? "hb-drift" : undefined}
        style={drift ? { animationDuration: `${drift}s`, animationDelay: `${-(x % 9)}s` } : undefined}
      >
        {puffs}
        <rect x={x - 20 * scale} y={y - 6 * scale} width={w + 40 * scale} height={10 * scale} rx={5 * scale} fill="#b88fcb" opacity="0.85" />
      </g>
    </g>
  );
}

/* ------------------------------------------------------------- HeroSky */

/** Sky, sun glow, the two great peaks and high clouds — slow parallax. */
export function HeroSky() {
  return (
    <g>
      <HeroDefs />
      <rect x="-200" y="-2400" width="2000" height="2300" fill="#3f2c78" />
      <rect x="-200" y="-200" width="2000" height="1300" fill="url(#hh-sky)" />
      <rect className="hb-breathe" x="-200" y="0" width="2000" height="1100" fill="url(#hh-sun)" />

      {/* thin high clouds */}
      {[
        [120, 150, 260],
        [1180, 120, 300],
        [700, 230, 200],
      ].map(([x, y, w], i) => (
        <g key={i} className="hb-drift" style={{ animationDuration: `${44 + i * 9}s` }}>
          <ellipse cx={x + w / 2} cy={y} rx={w / 2} ry="7" fill="#f6cfe2" opacity="0.5" />
        </g>
      ))}

      {/* the two great peaks behind the title */}
      <Peak peak={[400, 130]} left={-170} right={930} base={900} seed={3} />
      <Peak peak={[1200, 150]} left={700} right={1830} base={900} seed={8} />
      {/* shoulder peaks */}
      <Peak peak={[90, 330]} left={-220} right={360} base={900} seed={14} snow={false} />
      <Peak peak={[1500, 300]} left={1240} right={1820} base={900} seed={21} snow={false} />

      <rect x="-200" y="420" width="2000" height="300" fill="url(#hh-haze)" />

      {/* cloud banks wrapped around the peaks */}
      <CloudBank x={-60} y={520} w={480} seed={31} scale={0.85} drift={48} opacity={0.8} />
      <CloudBank x={1000} y={500} w={520} seed={37} scale={0.85} drift={56} opacity={0.8} />
      <CloudBank x={420} y={590} w={400} seed={41} scale={0.7} drift={40} fill="url(#hh-cloud-dusk)" opacity={0.7} />
      <rect x="-200" y="560" width="2000" height="560" fill="#e8a6b6" opacity="0.4" />
      {/* nearer peaks, the mountain falls, and the mist at their feet */}
      <Peak peak={[560, 420]} left={330} right={860} base={860} seed={51} light={LIGHT_P} dark={DARK_P} />
      <Peak peak={[1080, 470]} left={860} right={1330} base={860} seed={57} snow={false} light={LIGHT_P} dark={DARK_P} />
      <g>
        <rect x="508" y="488" width="18" height="170" fill="url(#hh-fall)" />
        {[512, 516, 521].map((x, i) => (
          <line key={x} className="hb-flow" style={{ animationDuration: `${1 + i * 0.3}s` }} x1={x} y1="488" x2={x} y2="658" stroke="#ffffff" strokeWidth="1.6" strokeDasharray="18 12" opacity="0.8" />
        ))}
        <ellipse className="hb-mist" cx="517" cy="660" rx="40" ry="10" fill="#ffffff" opacity="0.5" filter="url(#hh-soft)" />
      </g>
      <CloudBank x={250} y={720} w={340} seed={59} scale={0.8} drift={42} opacity={0.75} />
      <CloudBank x={960} y={700} w={360} seed={63} scale={0.85} drift={46} opacity={0.75} />
      <CloudBank x={600} y={800} w={440} seed={73} scale={0.75} drift={36} fill="url(#hh-cloud-dusk)" opacity={0.8} />

    </g>
  );
}

/* ------------------------------------------------------ street perspective */

/** vanishing point: the far waterfall at the end of the river */
const VPX = 820;
const VPY = 860;
/** eye height above the promenade, in screen units at the frame edge */
const EYE = 86;
const NEAR_L = -90;
const NEAR_R = 1690;

/** screen nearness t (1 at the frame edge → 0 at the vanishing point) for depth z */
const tAt = (z: number) => 1 / (1 + z * 0.34);
const xAt = (side: -1 | 1, t: number) => VPX + ((side < 0 ? NEAR_L : NEAR_R) - VPX) * t;
const groundY = (t: number) => VPY + EYE * t;
const roofY = (t: number, H: number) => VPY - H * t;
/** nearness of a screen x on a given side */
const tOfX = (side: -1 | 1, x: number) => (x - VPX) / ((side < 0 ? NEAR_L : NEAR_R) - VPX);

/** Bilinear point on a quad [TL, TR, BR, BL]. */
function bi(qd: [P, P, P, P], u: number, v: number): P {
  const top: P = [lerp(qd[0][0], qd[1][0], u), lerp(qd[0][1], qd[1][1], u)];
  const bot: P = [lerp(qd[3][0], qd[2][0], u), lerp(qd[3][1], qd[2][1], u)];
  return [lerp(top[0], bot[0], v), lerp(top[1], bot[1], v)];
}

type Style = "classic" | "glass" | "brick";
type Roof = "flat" | "dome" | "pediment" | "tower";
type Bldg = { len: number; H: number; style: Style; roof?: Roof; gap?: number };

const FACE_FILL: Record<Style, string> = {
  classic: "url(#hh-classic)",
  glass: "url(#hh-glass)",
  brick: "url(#hh-brick)",
};

/** One building on a street wall: its street facade in perspective, plus its
 *  viewer-facing front (the stepped skyline you see down the street). */
function StreetBuilding({ side, z0, b, seed }: { side: -1 | 1; z0: number; b: Bldg; seed: number }) {
  const r = rng(seed);
  const ta = tAt(z0);
  const tb = tAt(z0 + b.len);
  const xa = xAt(side, ta);
  const xb = xAt(side, tb);
  const facade: [P, P, P, P] = [
    [xa, roofY(ta, b.H)],
    [xb, roofY(tb, b.H)],
    [xb, groundY(tb)],
    [xa, groundY(ta)],
  ];
  // front face at the near end, extending away from the river
  const depth = 170 * ta;
  const fx0 = side < 0 ? xa - depth : xa;
  const fTop = roofY(ta, b.H);
  const fBot = groundY(ta);

  const out: ReactNode[] = [];

  /* front face */
  out.push(<rect key="ff" x={q(fx0)} y={q(fTop)} width={q(depth)} height={q(fBot - fTop)} fill="url(#hh-front)" />);
  {
    const cols = Math.max(2, Math.round(depth / (26 * ta + 6)));
    const ww = (depth / cols) * 0.42;
    const rowH = 30 * ta + 4;
    const wh = rowH * 0.55;
    for (let y = fTop + 16 * ta + 6, row = 0; y + wh < fBot - 10 * ta; y += rowH, row++) {
      for (let c = 0; c < cols; c++) {
        const lit = r() < 0.4;
        const wx = fx0 + (c + 0.5) * (depth / cols) - ww / 2;
        out.push(
          <rect
            key={`fw${row}-${c}`}
            className={lit && r() > 0.8 ? "hb-twinkle" : undefined}
            style={lit ? { animationDelay: `${(r() * 8).toFixed(1)}s` } : undefined}
            x={q(wx)}
            y={q(y)}
            width={q(ww)}
            height={q(wh)}
            fill={lit ? (r() < 0.5 ? "#ffcf7a" : "#ffad5c") : "#1e1546"}
            opacity={lit ? 0.95 : 0.9}
          />
        );
      }
    }
  }
  // rim light along the front face's river edge and top
  out.push(<rect key="fr" x={q(side < 0 ? xa - 2.5 : xa)} y={q(fTop)} width="2.5" height={q(fBot - fTop)} fill="#ffb27c" opacity="0.8" />);
  out.push(<rect key="ft" x={q(fx0)} y={q(fTop)} width={q(depth)} height={q(3 + 5 * ta)} fill="#ff9f7a" opacity="0.55" />);

  /* roof ornaments on the front face */
  const fcx = fx0 + depth / 2;
  if (b.roof === "dome") {
    const dw = depth * 0.42;
    out.push(
      <g key="dome">
        <rect x={q(fcx - dw * 0.55)} y={q(fTop - dw * 0.22)} width={q(dw * 1.1)} height={q(dw * 0.22)} fill="#2f2168" />
        <path d={`M${q(fcx - dw / 2)} ${q(fTop - dw * 0.22)} Q${q(fcx - dw / 2)} ${q(fTop - dw * 0.95)} ${q(fcx)} ${q(fTop - dw * 1.05)} Q${q(fcx + dw / 2)} ${q(fTop - dw * 0.95)} ${q(fcx + dw / 2)} ${q(fTop - dw * 0.22)} Z`} fill="url(#hh-dome)" />
        <line x1={q(fcx)} y1={q(fTop - dw * 1.05)} x2={q(fcx)} y2={q(fTop - dw * 1.3)} stroke="#ffc46b" strokeWidth={q(1 + ta * 2)} />
      </g>
    );
  } else if (b.roof === "pediment") {
    out.push(<polygon key="ped" points={pts([[fx0 - 3, fTop], [fcx, fTop - depth * 0.28], [fx0 + depth + 3, fTop]])} fill="#3a2a74" />);
    out.push(<polygon key="ped2" points={pts([[fx0 + depth * 0.12, fTop - 2], [fcx, fTop - depth * 0.2], [fx0 + depth * 0.88, fTop - 2]])} fill="none" stroke="#ff9f7a" strokeWidth="1.4" opacity="0.6" />);
  } else if (b.roof === "tower") {
    const tw = depth * 0.3;
    out.push(<rect key="tw" x={q(fcx - tw / 2)} y={q(fTop - tw * 1.6)} width={q(tw)} height={q(tw * 1.6)} fill="#2f2168" />);
    out.push(<polygon key="tws" points={pts([[fcx - tw * 0.6, fTop - tw * 1.6], [fcx, fTop - tw * 2.6], [fcx + tw * 0.6, fTop - tw * 1.6]])} fill="url(#hh-dome)" />);
    out.push(<circle key="twc" cx={q(fcx)} cy={q(fTop - tw * 1.05)} r={q(tw * 0.22)} fill="#ffd894" opacity="0.9" />);
  }

  /* street facade (perspective) */
  out.push(<polygon key="fa" points={pts(facade)} fill={FACE_FILL[b.style]} />);
  out.push(<polygon key="fs" points={pts(facade)} fill={side < 0 ? "url(#hh-sheenL)" : "url(#hh-sheenR)"} />);

  const floors = Math.max(4, Math.round(b.H / 62));
  const bays = b.style === "glass" ? 7 : Math.max(3, Math.round(b.len * 3.2));
  // horizontal courses following the perspective lines
  for (let f = 1; f < floors; f++) {
    const v = f / floors;
    const p1 = bi(facade, 0, v);
    const p2 = bi(facade, 1, v);
    out.push(<line key={`c${f}`} x1={q(p1[0])} y1={q(p1[1])} x2={q(p2[0])} y2={q(p2[1])} stroke="#1c1340" strokeWidth={q(1 + 2.5 * ta)} opacity="0.55" />);
  }
  // pilasters / mullions
  for (let k = 0; k <= bays; k++) {
    const u = k / bays;
    const p1 = bi(facade, u, 0);
    const p2 = bi(facade, u, 1);
    const tt = lerp(ta, tb, u);
    out.push(
      <line
        key={`p${k}`}
        x1={q(p1[0])}
        y1={q(p1[1])}
        x2={q(p2[0])}
        y2={q(p2[1])}
        stroke={b.style === "glass" ? "#7d6ad6" : "#c4789e"}
        strokeWidth={q((b.style === "glass" ? 0.8 : 2) * (0.4 + tt))}
        opacity={b.style === "glass" ? 0.55 : 0.45}
      />
    );
  }
  // windows: arched for classic, plain for brick, panes for glass
  if (b.style !== "glass") {
    for (let f = 0; f < floors; f++) {
      for (let k = 0; k < bays; k++) {
        const u0 = (k + 0.28) / bays;
        const u1 = (k + 0.72) / bays;
        const v0 = (f + 0.22) / floors;
        const v1 = (f + 0.82) / floors;
        const tl = bi(facade, u0, v0);
        const tr = bi(facade, u1, v0);
        const br = bi(facade, u1, v1);
        const bl = bi(facade, u0, v1);
        const lit = r() < 0.22;
        const pink = !lit && r() < 0.35;
        const h = Math.abs(bl[1] - tl[1]);
        const d =
          b.style === "classic"
            ? `M${q(bl[0])},${q(bl[1])} L${q(tl[0])},${q(tl[1] + h * 0.22)} Q${q((tl[0] + tr[0]) / 2)},${q(Math.min(tl[1], tr[1]) - h * 0.12)} ${q(tr[0])},${q(tr[1] + h * 0.22)} L${q(br[0])},${q(br[1])} Z`
            : `M${q(tl[0])},${q(tl[1])} L${q(tr[0])},${q(tr[1])} L${q(br[0])},${q(br[1])} L${q(bl[0])},${q(bl[1])} Z`;
        out.push(
          <path
            key={`w${f}-${k}`}
            className={lit && r() > 0.7 ? "hb-twinkle" : undefined}
            style={lit ? { animationDelay: `${(r() * 9).toFixed(1)}s` } : undefined}
            d={d}
            fill={lit ? "#ffc06e" : pink ? "#b56aa6" : "#24194e"}
            opacity={lit ? 0.92 : 0.88}
          />
        );
      }
    }
  } else {
    // glass curtain wall: a sweep of sunset reflection
    out.push(<polygon key="gl" points={pts(facade)} fill="url(#hh-reflect)" opacity="0.55" />);
    for (let f = 0; f < floors; f++)
      for (let k = 0; k < bays; k++)
        if (r() < 0.12) {
          const a = bi(facade, (k + 0.15) / bays, (f + 0.25) / floors);
          const c = bi(facade, (k + 0.85) / bays, (f + 0.25) / floors);
          const d2 = bi(facade, (k + 0.85) / bays, (f + 0.75) / floors);
          const e = bi(facade, (k + 0.15) / bays, (f + 0.75) / floors);
          out.push(<polygon key={`g${f}-${k}`} points={pts([a, c, d2, e])} fill="#ffc06e" opacity="0.85" />);
        }
  }
  // cornice along the roofline
  out.push(
    <polygon
      key="cor"
      points={pts([
        [xa, roofY(ta, b.H) - 8 * ta],
        [xb, roofY(tb, b.H) - 8 * tb],
        [xb, roofY(tb, b.H) + 4 * tb],
        [xa, roofY(ta, b.H) + 4 * ta],
      ])}
      fill="#2a1c5c"
    />
  );
  out.push(<line key="corl" x1={q(xa)} y1={q(roofY(ta, b.H) - 8 * ta)} x2={q(xb)} y2={q(roofY(tb, b.H) - 8 * tb)} stroke="#ffb27c" strokeWidth={q(1 + ta)} opacity="0.7" />);

  return <g>{out}</g>;
}

/** A street wall: buildings laid out by depth, drawn far → near. */
function StreetWall({ side, list, seed }: { side: -1 | 1; list: Bldg[]; seed: number }) {
  const zs: number[] = [];
  let z = 0;
  for (const b of list) {
    zs.push(z);
    z += b.len + (b.gap ?? 0);
  }
  return (
    <g>
      {list
        .map((b, i) => <StreetBuilding key={i} side={side} z0={zs[i]} b={b} seed={seed + i * 7} />)
        .reverse()}
    </g>
  );
}

const LEFT_ST: Bldg[] = [
  { len: 0.7, H: 760, style: "classic", roof: "flat" },
  { len: 0.9, H: 640, style: "glass", roof: "flat" },
  { len: 1.1, H: 520, style: "classic", roof: "pediment" },
  { len: 0.9, H: 600, style: "brick", roof: "tower" },
  { len: 1.4, H: 470, style: "classic", roof: "dome" },
  { len: 1.3, H: 560, style: "glass", roof: "flat" },
  { len: 1.6, H: 430, style: "brick", roof: "pediment" },
  { len: 2.0, H: 520, style: "classic", roof: "flat" },
  { len: 3.0, H: 420, style: "brick", roof: "flat" },
  { len: 6.0, H: 380, style: "classic", roof: "flat" },
];
const RIGHT_ST: Bldg[] = [
  { len: 1.0, H: 720, style: "brick", roof: "flat" },
  { len: 0.8, H: 560, style: "classic", roof: "dome" },
  { len: 1.1, H: 640, style: "glass", roof: "flat" },
  { len: 1.0, H: 500, style: "classic", roof: "tower" },
  { len: 1.4, H: 590, style: "brick", roof: "pediment" },
  { len: 1.5, H: 450, style: "glass", roof: "flat" },
  { len: 1.8, H: 520, style: "classic", roof: "dome" },
  { len: 2.6, H: 440, style: "brick", roof: "flat" },
  { len: 6.0, H: 360, style: "classic", roof: "flat" },
];

/* ---------------------------------------------------------------- lamps */

function Lamp({ side, z }: { side: -1 | 1; z: number }) {
  const t = tAt(z);
  // lamps stand a little in front of the facades, on the promenade
  const x = xAt(side, t) - side * 70 * t;
  const tt = tOfX(side, x);
  const yb = groundY(tt) + 6 * tt;
  const h = 300 * tt;
  const yh = yb - h;
  const spread = 10 + 46 * tt;
  return (
    <g>
      <polygon
        className="hb-flicker"
        style={{ animationDelay: `${(z * 1.9) % 7}s` }}
        points={pts([
          [x - 2 - tt * 3, yh],
          [x + 2 + tt * 3, yh],
          [x + spread, yb],
          [x - spread, yb],
        ])}
        fill="url(#hh-cone)"
      />
      <line x1={q(x)} y1={q(yb)} x2={q(x)} y2={q(yh - 4)} stroke="#20163f" strokeWidth={q(1 + tt * 3)} />
      <rect x={q(x - 3 - tt * 5)} y={q(yh - 6 - tt * 6)} width={q(6 + tt * 10)} height={q(5 + tt * 6)} rx="1" fill="#20163f" />
      <circle cx={q(x)} cy={q(yh + 1)} r={q(2 + tt * 3)} fill="#fff7d4" />
    </g>
  );
}

/* --------------------------------------------------------------- rocks */

function Boulder({ cx, cy, w, h, seed, tone = 0 }: { cx: number; cy: number; w: number; h: number; seed: number; tone?: number }) {
  const r = rng(seed);
  const pal = [
    ["#7d4592", "#c98ac8", "#4a2672", "#f0b6dc"],
    ["#6e3d8c", "#b07ac2", "#3f2268", "#e3a8d6"],
    ["#8d4f98", "#dc98c8", "#56307e", "#ffc6e2"],
  ][tone % 3];
  const P0: P[] = [];
  const n = 9;
  for (let i = 0; i < n; i++) {
    const a = Math.PI + (i / (n - 1)) * Math.PI;
    const j = 0.84 + r() * 0.26;
    P0.push([cx + (Math.cos(a) * w) / 2 * j, cy + Math.sin(a) * h * j]);
  }
  const body: P[] = [...P0, [cx + w / 2, cy + h * 0.4], [cx - w / 2, cy + h * 0.4]];
  const top: P[] = [P0[1], P0[2], P0[3], P0[4], P0[5], [cx + w * 0.1, cy - h * 0.35], [cx - w * 0.22, cy - h * 0.15]];
  const shade: P[] = [P0[6], P0[7], P0[8], [cx + w / 2, cy + h * 0.4], [cx + w * 0.08, cy + h * 0.2]];
  const hl: P[] = [P0[2], P0[3], [cx - w * 0.12, cy - h * 0.62]];
  return (
    <g>
      <polygon points={pts(body)} fill={pal[0]} />
      <polygon points={pts(top)} fill={pal[1]} opacity="0.92" />
      <polygon points={pts(shade)} fill={pal[2]} opacity="0.8" />
      <polygon points={pts(hl)} fill={pal[3]} opacity="0.75" />
    </g>
  );
}

/* ------------------------------------------------------------ HeroStreet */

export function HeroStreet({ spill }: { spill: [number, number] }) {
  const r = rng(77);
  const [s0, s1] = spill;

  // river edges: from the far falls to the bottom of the frame
  const RL: P[] = [[VPX - 16, VPY + 2], [360, 1016]];
  const RR: P[] = [[VPX + 16, VPY + 2], [1270, 1016]];
  const riverX = (side: -1 | 1, y: number) => {
    const [a, b] = side < 0 ? RL : RR;
    return lerp(a[0], b[0], (y - a[1]) / (b[1] - a[1]));
  };

  // cascade: tiers where the river steps down, each a band of white water
  const tiers = [884, 908, 938, 972, 1006].map((y, i) => {
    const xl = riverX(-1, y) + 6;
    const xr = riverX(1, y) - 6;
    const w = xr - xl;
    const amp = 2 + i * 1.6;
    const segs = 8 + i * 2;
    let d = `M${q(xl)},${q(y)}`;
    for (let k = 1; k <= segs; k++) d += ` L${q(xl + (w * k) / segs)},${q(y - (k % 2 ? amp : 0) - r() * amp)}`;
    d += ` L${q(xr)},${q(y + 6 + i * 3)} L${q(xl)},${q(y + 6 + i * 3)} Z`;
    return (
      <g key={i}>
        <path d={d} fill="#ffffff" opacity="0.9" />
        <rect
          className="hb-shimmer"
          style={{ animationDelay: `${-i * 0.5}s` }}
          x={q(xl)}
          y={q(y + 6 + i * 3)}
          width={q(w)}
          height={q(8 + i * 3)}
          fill="#dfe8ff"
          opacity="0.6"
        />
        {/* spray drifting off each step */}
        {Array.from({ length: 3 + i }).map((_, k) => (
          <ellipse
            key={k}
            className="hb-foam"
            style={{ animationDelay: `${(-r() * 4).toFixed(1)}s`, animationDuration: `${(2 + r() * 2).toFixed(1)}s` }}
            cx={q(xl + w * (0.1 + r() * 0.8))}
            cy={q(y - 2)}
            rx={q(8 + i * 6 + r() * 10)}
            ry={q(2 + i * 0.8)}
            fill="#ffffff"
            opacity="0.85"
          />
        ))}
      </g>
    );
  });

  // promenade railing along each wall's foot
  const railing = (side: -1 | 1) => {
    const posts: ReactNode[] = [];
    let prev: P | null = null;
    const rails: ReactNode[] = [];
    for (let z = 0.15; z < 14; z += 0.25) {
      const t = tAt(z);
      const x = xAt(side, t) - side * 105 * t;
      const tt = tOfX(side, x);
      const y = groundY(tt) + 10 * tt;
      const h = 26 * tt;
      posts.push(<line key={z.toFixed(2)} x1={q(x)} y1={q(y)} x2={q(x)} y2={q(y - h)} stroke="#20163f" strokeWidth={q(0.6 + tt * 1.6)} />);
      if (prev) rails.push(<line key={`r${z.toFixed(2)}`} x1={q(prev[0])} y1={q(prev[1])} x2={q(x)} y2={q(y - h)} stroke="#20163f" strokeWidth={q(1 + tt * 2.2)} />);
      prev = [x, y - h];
    }
    return (
      <g>
        {posts}
        {rails}
      </g>
    );
  };

  // promenades: from the facades' foot to the river wall
  const prom = (side: -1 | 1) => {
    const near = side < 0 ? NEAR_L : NEAR_R;
    const edge = side < 0 ? RL : RR;
    return (
      <g>
        <polygon points={pts([[near, groundY(1)], [VPX, VPY], edge[0], edge[1], [near, 1016]])} fill="url(#hh-bank)" />
        {/* river wall face */}
        <polygon points={pts([edge[0], edge[1], [edge[1][0] + side * 40, 1016], [edge[0][0] + side * 3, edge[0][1] + 4]])} fill="#2b1b55" />
        <line x1={q(edge[0][0])} y1={q(edge[0][1])} x2={q(edge[1][0])} y2={q(edge[1][1])} stroke="#ffbf8a" strokeWidth="2" opacity="0.5" />
      </g>
    );
  };

  return (
    <g>
      {/* the far falls the river starts from */}
      <rect x={VPX - 16} y="770" width="32" height={VPY - 770 + 4} fill="url(#hh-fall)" />
      {[VPX - 10, VPX - 2, VPX + 7].map((x, i) => (
        <line key={x} className="hb-flow" style={{ animationDuration: `${1 + i * 0.25}s` }} x1={x} y1="770" x2={x} y2={VPY + 4} stroke="#ffffff" strokeWidth="2.4" strokeDasharray="20 12" opacity="0.85" />
      ))}

      <StreetWall side={-1} list={LEFT_ST} seed={300} />
      <StreetWall side={1} list={RIGHT_ST} seed={500} />
      {/* warm sunset wash on the near-left corner, as in the reference */}
      <rect x="-60" y="120" width="220" height="760" fill="url(#hh-wash)" />

      {prom(-1)}
      {prom(1)}

      {/* lamps behind the railing */}
      {[0.25, 1.1, 2.1, 3.3, 4.8, 6.6, 9, 12].map((z) => (
        <Lamp key={`l${z}`} side={-1} z={z} />
      ))}
      {[0.5, 1.4, 2.5, 3.8, 5.4, 7.4, 10, 13].map((z) => (
        <Lamp key={`r${z}`} side={1} z={z} />
      ))}
      {railing(-1)}
      {railing(1)}

      {/* river and its cascade */}
      <polygon points={pts([RL[0], RR[0], RR[1], RL[1]])} fill="url(#hh-river)" />
      <ellipse className="hb-mist" cx={VPX} cy={VPY + 2} rx="44" ry="8" fill="#ffffff" opacity="0.8" />
      {tiers}

      {/* boulders in and along the river */}
      <Boulder cx={VPX - 34} cy={878} w={40} h={12} seed={1} tone={2} />
      <Boulder cx={VPX + 44} cy={890} w={50} h={14} seed={2} tone={1} />
      <Boulder cx={690} cy={922} w={80} h={22} seed={3} />
      <Boulder cx={960} cy={930} w={90} h={24} seed={4} tone={2} />
      <Boulder cx={560} cy={962} w={120} h={34} seed={5} tone={1} />
      <Boulder cx={1080} cy={968} w={130} h={36} seed={14} />
      <Boulder cx={70} cy={1000} w={300} h={110} seed={6} />
      <Boulder cx={260} cy={1010} w={240} h={86} seed={7} tone={2} />
      <Boulder cx={440} cy={1004} w={200} h={70} seed={8} tone={1} />
      <Boulder cx={s0 - 50} cy={1010} w={130} h={44} seed={9} />
      <Boulder cx={s1 + 60} cy={1010} w={140} h={48} seed={10} tone={2} />
      <Boulder cx={1100} cy={1004} w={210} h={72} seed={11} tone={1} />
      <Boulder cx={1300} cy={1010} w={260} h={96} seed={12} />
      <Boulder cx={1510} cy={1000} w={300} h={116} seed={13} tone={2} />
    </g>
  );
}
