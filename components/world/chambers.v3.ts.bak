/**
 * Mission (print chamber) and Advantages (survey wheel) scenes for the
 * Heritage scroll-world. Each is a 1440 × 900 illustration returned as an
 * SVG string (deterministic — same output on server and client), placed
 * into the world by art.tsx at scale 1600/1440.
 *
 * Animated with SMIL (<animate>, pattern scrolling) plus the .hbr-* CSS
 * classes in globals.css. All ids are prefixed "hbr-" to stay unique.
 */

const VW = 1440;
const VH = 900;
type P = [number, number];

const f = (n: number) => Math.round(n * 10) / 10;
const pts = (a: P[]) => a.map((p) => `${f(p[0])},${f(p[1])}`).join(" ");

function rng(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

/* ------------------------------------------------------------------ defs */

export const CHAMBER_DEFS = `
<linearGradient id="hbr-fallH" x1="0" x2="1"><stop offset="0" stop-color="#3b3d9c"/><stop offset=".3" stop-color="#8b9ef2"/><stop offset=".52" stop-color="#e2dcff"/><stop offset=".78" stop-color="#7d88e0"/><stop offset="1" stop-color="#363892"/></linearGradient>
<pattern id="hbr-streak" width="48" height="260" patternUnits="userSpaceOnUse">
  <rect x="3" width="3" height="260" fill="#fff" opacity=".32"/>
  <rect x="11" y="30" width="6" height="170" fill="#ece6ff" opacity=".22"/>
  <rect x="21" width="2" height="260" fill="#fff" opacity=".42"/>
  <rect x="27" y="80" width="9" height="150" fill="#ffc9e6" opacity=".22"/>
  <rect x="40" y="10" width="3" height="120" fill="#fff" opacity=".4"/>
  <rect x="40" y="160" width="3" height="80" fill="#ffd6e8" opacity=".3"/>
  <animateTransform attributeName="patternTransform" type="translate" from="0 0" to="0 260" dur="1.4s" repeatCount="indefinite"/>
</pattern>
<linearGradient id="hbr-wall" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#271a55"/><stop offset=".6" stop-color="#22164c"/><stop offset="1" stop-color="#1b1140"/></linearGradient>
<linearGradient id="hbr-floor" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3b2d82"/><stop offset="1" stop-color="#1c1342"/></linearGradient>
<linearGradient id="hbr-glass" x1="0" y1="0" x2="0" y2="1">
  <stop offset="0" stop-color="#e7defe" stop-opacity=".55"/><stop offset=".35" stop-color="#e8c5e2" stop-opacity=".62"/>
  <stop offset=".62" stop-color="#ffa565"/><stop offset="1" stop-color="#ff5d2a"/>
</linearGradient>
<linearGradient id="hbr-glassEdge" x1="0" x2="1"><stop offset="0" stop-color="#1c1342" stop-opacity=".55"/><stop offset=".12" stop-color="#1c1342" stop-opacity="0"/><stop offset=".88" stop-color="#1c1342" stop-opacity="0"/><stop offset="1" stop-color="#1c1342" stop-opacity=".55"/></linearGradient>
<radialGradient id="hbr-bub" cx=".42" cy=".38" r=".6">
  <stop offset="0" stop-color="#fff2c6" stop-opacity=".25"/><stop offset=".6" stop-color="#ffb35c" stop-opacity=".35"/>
  <stop offset=".9" stop-color="#ff8a3d" stop-opacity=".95"/><stop offset="1" stop-color="#ff8a3d" stop-opacity="0"/>
</radialGradient>
<linearGradient id="hbr-rail" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ffcf7a" stop-opacity=".75"/><stop offset="1" stop-color="#ff8a3d" stop-opacity=".25"/></linearGradient>
<filter id="hbr-blur12" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="12"/></filter>
<filter id="hbr-blur28" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="28"/></filter>
<filter id="hbr-glow" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="5" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
`;

/* --------------------------------------------------------- shared pieces */

function fall(x: number, y: number, w: number, h: number, mist = true) {
  let g =
    `<g><rect x="${x}" y="${y}" width="${w}" height="${h}" fill="url(#hbr-fallH)" opacity=".88"/>` +
    `<rect x="${x}" y="${y}" width="${w}" height="${h}" fill="url(#hbr-streak)"/>` +
    `<rect x="${x - 6}" y="${y}" width="${w + 12}" height="${h}" fill="#b9b4ff" opacity=".12" filter="url(#hbr-blur12)"/>`;
  if (mist) {
    for (let i = 0; i < 5; i++) {
      g += `<ellipse class="hbr-tw" style="--d:${3 + i}s;--dl:${-i}s" cx="${x + w / 2 + (i - 2) * w * 0.35}" cy="${y + h - 8}" rx="${w * 0.55}" ry="${22 + i * 4}" fill="#d6ccff" opacity=".4" filter="url(#hbr-blur12)"/>`;
    }
  }
  return g + "</g>";
}

function person(x: number, y: number, s = 1, coat = "#d9cdf2", flip = false, pose = "stand") {
  let g = `<g transform="translate(${f(x)} ${f(y)}) scale(${flip ? -s : s} ${s})">`;
  g += `<rect x="-6" y="-22" width="4.6" height="22" fill="#24184a"/><rect x="1.4" y="-22" width="4.6" height="22" fill="#24184a"/>`;
  if (pose === "raise")
    g += `<path d="M-6 -42 L-15 -57 M6 -42 L15 -57" stroke="${coat}" stroke-width="3.6" stroke-linecap="round"/>`;
  if (pose === "reach")
    g += `<path class="hbr-reach" d="M5 -42 L17 -36" stroke="${coat}" stroke-width="3.6" stroke-linecap="round"/>`;
  g += `<path d="M-9 -18 L-7.5 -45 Q0 -49 7.5 -45 L9 -18 Z" fill="${coat}"/><path d="M1 -47 L7.5 -45 L9 -18 L2 -18Z" fill="#1a0f36" opacity=".22"/>`;
  g += `<circle cx="0" cy="-52" r="5.4" fill="#e7b38f"/><path d="M-5.6 -52.5a5.6 5.6 0 0 1 11.2 0c0-1.5-2-4.5-5.6-4.5s-5.6 3-5.6 4.5z" fill="#33204e"/>`;
  return g + "</g>";
}

let holoN = 0;
function holo(x: number, y: number, w: number, h: number, kind = "chart", skew = 0) {
  // each hologram drifts a touch, out of phase with its neighbours
  const dl = -((holoN++ * 1.37) % 5);
  let g = `<g transform="translate(${x} ${y}) skewY(${skew})"><g class="hbr-holo" style="--dl:${f(dl)}s"><rect width="${w}" height="${h}" rx="2" fill="#a9d8ff" fill-opacity=".16" stroke="#d5edff" stroke-opacity=".9" stroke-width="1.4" filter="url(#hbr-glow)"/>`;
  if (kind === "chart") {
    g += `<polyline class="hbr-chart" points="${f(w * 0.08)},${f(h * 0.8)} ${f(w * 0.3)},${f(h * 0.55)} ${f(w * 0.5)},${f(h * 0.62)} ${f(w * 0.72)},${f(h * 0.3)} ${f(w * 0.9)},${f(h * 0.38)}" fill="none" stroke="#e7f5ff" stroke-width="1.4"/><circle cx="${f(w * 0.72)}" cy="${f(h * 0.3)}" r="2.4" fill="#fff"/>`;
  }
  if (kind === "arch") {
    const cx = w / 2, b = h * 0.86, aw = w * 0.28;
    g += `<path d="M${f(w * 0.12)} ${f(b)}H${f(w * 0.88)} M${f(cx - aw)} ${f(b)}V${f(h * 0.45)}A${f(aw)} ${f(aw)} 0 0 1 ${f(cx + aw)} ${f(h * 0.45)}V${f(b)} M${f(cx - aw * 0.55)} ${f(b)}V${f(h * 0.5)}A${f(aw * 0.55)} ${f(aw * 0.55)} 0 0 1 ${f(cx + aw * 0.55)} ${f(h * 0.5)}V${f(b)} M${f(w * 0.12)} ${f(h * 0.2)}h${f(w * 0.2)} M${f(w * 0.12)} ${f(h * 0.3)}h${f(w * 0.14)}" fill="none" stroke="#e7f5ff" stroke-width="1.1" opacity=".9"/>`;
  }
  if (kind === "dome") {
    const cx = w / 2, b = h * 0.85;
    g += `<path d="M${f(w * 0.15)} ${f(b)}H${f(w * 0.85)} M${f(w * 0.22)} ${f(b)}V${f(h * 0.55)}H${f(w * 0.78)}V${f(b)} M${f(w * 0.32)} ${f(h * 0.55)}Q${f(w * 0.3)} ${f(h * 0.2)} ${f(cx)} ${f(h * 0.12)}Q${f(w * 0.7)} ${f(h * 0.2)} ${f(w * 0.68)} ${f(h * 0.55)}" fill="none" stroke="#e7f5ff" stroke-width="1.1"/>`;
    for (let i = 0; i < 5; i++)
      g += `<line x1="${f(w * (0.28 + i * 0.11))}" y1="${f(h * 0.6)}" x2="${f(w * (0.28 + i * 0.11))}" y2="${f(b)}" stroke="#e7f5ff" stroke-width="1" opacity=".7"/>`;
  }
  // scan line sweeping down the panel
  g += `<rect class="hbr-scan" style="--h:${h - 2}px" x="1" y="0" width="${w - 2}" height="2" fill="#e7f5ff" opacity=".5"/>`;
  return g + "</g></g>";
}

function bubbles(seed: number, n: number, x0: number, x1: number, yb: number, dist: number, rmin: number, rmax: number, speed = 5) {
  const r = rng(seed);
  let g = "";
  for (let i = 0; i < n; i++) {
    const rr = rmin + r() * (rmax - rmin);
    const x = x0 + r() * (x1 - x0);
    const d = speed + r() * 4;
    g += `<circle class="hbr-bub" style="--d:${f(d)}s;--dl:${f(-r() * d)}s;--ty:${-f(dist * (0.6 + r() * 0.4))}px" cx="${f(x)}" cy="${f(yb - r() * 20)}" r="${f(rr)}" fill="url(#hbr-bub)"/>`;
  }
  return g;
}

function wall(seed: number) {
  const r = rng(seed);
  let g = `<rect width="${VW}" height="${VH}" fill="url(#hbr-wall)"/>`;
  for (let i = 0; i < 9; i++) {
    const ax = i * 180 - 60;
    g += `<path d="M${ax} 900V430a75 75 0 0 1 150 0V900" fill="none" stroke="#2f2068" stroke-width="9" opacity=".75"/><path d="M${ax + 20} 900V440a55 55 0 0 1 110 0V900" fill="none" stroke="#2a1b5e" stroke-width="2" opacity=".8"/>`;
  }
  for (let i = 0; i < 9; i++) {
    const x = r() * VW, y = 40 + r() * 360, w = 60 + r() * 160, h = 60 + r() * 160;
    g += `<rect x="${f(x)}" y="${f(y)}" width="${f(w)}" height="${f(h)}" rx="6" fill="none" stroke="#34246f" stroke-width="2" opacity=".7"/>`;
  }
  for (let i = 0; i < 16; i++) {
    const x = r() * VW, y = r() * 700, L = 80 + r() * 300, L2 = 40 + r() * 200, dir = r() < 0.5 ? 1 : -1, sw = 3 + r() * 6;
    const d = r() < 0.5 ? `M${f(x)} ${f(y)}h${f(L * dir)}v${f(L2)}` : `M${f(x)} ${f(y)}v${f(L2)}h${f(L * dir)}`;
    g += `<path d="${d}" fill="none" stroke="#35256f" stroke-width="${f(sw)}" stroke-linejoin="round" opacity=".85"/><path d="${d}" fill="none" stroke="#4d3a95" stroke-width="1" opacity=".55" transform="translate(-1 -1)"/>`;
    // a few pipes carry a pulse of light
    if (i % 4 === 0)
      g += `<path class="hbr-pipe" style="--dl:${f(-i * 0.7)}s" d="${d}" fill="none" stroke="#9d8cff" stroke-width="2" stroke-dasharray="18 400" opacity=".7"/>`;
  }
  return g;
}

/** Rocky underside of the floor above, with a gap the water falls through. */
function ledge(seed: number, gap0: number, gap1: number) {
  const r = rng(seed);
  const Pt: P[] = [[0, 0]];
  for (let x = 0; x <= VW; x += 40) {
    if (x > gap0 && x < gap1) continue;
    Pt.push([x, x > gap0 - 60 && x < gap1 + 60 ? 6 + r() * 10 : 18 + r() * 40]);
  }
  Pt.push([VW, 0]);
  const left = Pt.filter((p) => p[0] <= gap0);
  const right = Pt.filter((p) => p[0] >= gap1 || p[0] === VW);
  return `<polygon points="${pts([...left, [gap0, 0]])}" fill="#140c2e"/><polygon points="${pts([[gap1, 0], ...right])}" fill="#140c2e"/>`;
}

function floor(y = 760, glow = "#d24fc4") {
  return `<rect x="0" y="${y}" width="${VW}" height="${VH - y}" fill="url(#hbr-floor)"/><rect class="hbr-floorglow" x="0" y="${y - 2}" width="${VW}" height="4" fill="${glow}" opacity=".55" filter="url(#hbr-glow)"/>`;
}

function railing(x0: number, x1: number, y: number, h = 34, step = 26, col = "#120a2a", w = 2) {
  let g = `<path d="M${x0} ${y - h}H${x1} M${x0} ${y - h / 2}H${x1}" stroke="${col}" stroke-width="${w}"/>`;
  for (let x = x0; x <= x1; x += step)
    g += `<line x1="${x}" y1="${y}" x2="${x}" y2="${y - h}" stroke="${col}" stroke-width="${w}"/>`;
  return g;
}

/* ---------------------------------------------- MISSION: the print chamber */

function buildMission() {
  let g = wall(31);
  g += fall(585, 0, 160, 770);
  // chamber
  g += `<ellipse class="hbr-breathe" cx="1020" cy="440" rx="260" ry="420" fill="#ff8a3d" opacity=".12" filter="url(#hbr-blur28)"/>`;
  g += `<rect x="860" y="118" width="320" height="642" fill="url(#hbr-glass)"/>`;
  g += `<rect x="990" y="118" width="60" height="642" fill="#fff" opacity=".22" filter="url(#hbr-blur12)"/>`;
  // landmark being printed, layer by layer
  const model =
    `<rect x="905" y="705" width="230" height="55" fill="#6d2a63"/><rect x="895" y="695" width="250" height="12" fill="#7f3170"/>` +
    [0, 1, 2, 3, 4, 5].map((i) => `<rect x="${922 + i * 38}" y="610" width="14" height="86" fill="#7f3170"/>`).join("") +
    `<rect x="905" y="596" width="230" height="16" fill="#7f3170"/><rect x="960" y="548" width="120" height="50" fill="#6d2a63"/>` +
    `<path d="M952 550Q950 470 1020 440Q1090 470 1088 550Z" fill="#7f3170"/><rect x="1018" y="410" width="4" height="32" fill="#7f3170"/>`;
  g += `<clipPath id="hbr-cPrint"><rect x="880" y="760" width="280" height="0"><animate attributeName="y" values="760;404;404;760" keyTimes="0;.8;.95;1" dur="9s" repeatCount="indefinite"/><animate attributeName="height" values="0;356;356;0" keyTimes="0;.8;.95;1" dur="9s" repeatCount="indefinite"/></rect></clipPath>`;
  g += `<g opacity=".4" fill="none" stroke="#5a2a6e" stroke-dasharray="4 4">${model.replace(/fill="#[0-9a-f]+"/g, 'fill="none" stroke="#5a2a6e"')}</g>`;
  g += `<g clip-path="url(#hbr-cPrint)" opacity=".85">${model}</g>`;
  g += `<rect x="880" y="760" width="280" height="3" fill="#fff4c9" filter="url(#hbr-glow)"><animate attributeName="y" values="760;404;404;760" keyTimes="0;.8;.95;1" dur="9s" repeatCount="indefinite"/></rect>`;
  g += `<clipPath id="hbr-cGlass"><rect x="860" y="118" width="320" height="642"/></clipPath><g clip-path="url(#hbr-cGlass)">${bubbles(3, 26, 880, 1160, 760, 600, 5, 30, 5)}</g>`;
  g += `<rect x="860" y="118" width="320" height="642" fill="url(#hbr-glassEdge)"/>`;
  g += `<path d="M836 0H1204V96Q1204 122 1178 122H862Q836 122 836 96Z" fill="#2c2a86"/><rect x="842" y="98" width="356" height="24" fill="#3d3bb0"/><rect x="842" y="98" width="356" height="3" fill="#6d6be0"/>`;
  g += `<rect x="846" y="756" width="348" height="14" fill="#2c2a86"/>`;
  // balconies and people
  for (const y of [300, 510, 720]) {
    g += `<rect x="836" y="${y}" width="420" height="8" fill="#1a1238"/>` + railing(836, 1256, y, 34, 30, "#1a1238", 2.4) +
      `<path d="M1256 ${y + 4}L1340 ${y - 90}" stroke="#1a1238" stroke-width="5"/><path d="M1256 ${y - 30}L1340 ${y - 124}" stroke="#1a1238" stroke-width="2.4"/>`;
  }
  g += person(905, 300, 1, "#cfc2ec") + holo(925, 226, 46, 34, "chart") + person(1130, 300, 1, "#d6b9b0", true) + holo(1080, 216, 40, 30, "arch");
  g += person(980, 510, 1, "#cfc2ec") + person(1020, 510, 1, "#e2c7b6", true) + holo(1040, 436, 44, 32, "dome", -6);
  g += person(1020, 720, 1.05, "#d9cdf2", false, "raise") + holo(985, 622, 70, 44, "arch");
  // foreground operator and console
  g += floor(770);
  g += `<rect x="500" y="716" width="190" height="7" fill="#120a2a"/><path d="M515 723V770M675 723V770M560 723V770M630 723V770" stroke="#120a2a" stroke-width="3"/>`;
  g += person(540, 716, 0.95, "#e8b0a8") + holo(560, 672, 70, 26, "chart", -12);
  g += `<path d="M0 760L60 690H170L220 760Z" fill="#150c30"/>` + person(110, 900, 2.6, "#8f7cc0", false, "reach") + holo(170, 700, 120, 80, "chart") + holo(300, 690, 52, 40, "dome");
  g += ledge(41, 560, 770);
  return g;
}

/* -------------------------------------------- ADVANTAGES: the survey wheel */

function buildAdv() {
  let g = wall(57);
  g += fall(190, 0, 150, 560) + fall(565, 40, 26, 700, false);
  const cx = 330, cy = 600;
  g += `<circle class="hbr-breathe" cx="${cx}" cy="${cy}" r="270" fill="#ff4fa3" opacity=".12" filter="url(#hbr-blur28)"/>`;
  g += `<g><animateTransform attributeName="transform" type="rotate" from="0 ${cx} ${cy}" to="360 ${cx} ${cy}" dur="40s" repeatCount="indefinite"/>` +
    [0, 45, 90, 135].map((a) => `<rect x="${cx - 12}" y="${cy - 230}" width="24" height="460" fill="#2a2468" transform="rotate(${a} ${cx} ${cy})"/>`).join("") +
    `<path d="M${cx - 130} ${cy + 130}V${cy - 20}Q${cx - 130} ${cy - 140} ${cx} ${cy - 190}Q${cx + 130} ${cy - 140} ${cx + 130} ${cy - 20}V${cy + 130}Z" fill="none" stroke="#352c7c" stroke-width="26"/>` +
    `<path d="M${cx - 130} ${cy - 20}Q${cx - 130} ${cy - 140} ${cx} ${cy - 190}" fill="none" stroke="#ff4fa3" stroke-width="5" opacity=".8" filter="url(#hbr-glow)"/></g>`;
  g += `<g><animateTransform attributeName="transform" type="rotate" from="0 ${cx} ${cy}" to="-360 ${cx} ${cy}" dur="60s" repeatCount="indefinite"/><rect x="${cx - 95}" y="${cy - 95}" width="190" height="190" fill="none" stroke="#2f2a74" stroke-width="18" transform="rotate(20 ${cx} ${cy})"/><circle cx="${cx}" cy="${cy}" r="34" fill="#2f2a74"/><circle class="hbr-flick" cx="${cx}" cy="${cy}" r="12" fill="#ff7ab8" filter="url(#hbr-glow)"/></g>`;
  g += `<circle cx="${cx}" cy="${cy}" r="245" fill="none" stroke="#33307e" stroke-width="34"/><circle cx="${cx}" cy="${cy}" r="226" fill="none" stroke="#5a55b4" stroke-width="2"/><circle cx="${cx}" cy="${cy}" r="262" fill="none" stroke="#5a55b4" stroke-width="2"/>`;
  // rim lights chase around the wheel
  for (let i = 0; i < 12; i++) {
    const a = (i / 12) * Math.PI * 2;
    g += `<circle class="hbr-flick" style="animation-delay:${f(-i * 0.15)}s" cx="${f(cx + Math.cos(a) * 245)}" cy="${f(cy + Math.sin(a) * 245)}" r="5" fill="#dfe6ff" filter="url(#hbr-glow)"/>`;
  }
  g += `<polygon points="0,140 130,760 0,760" fill="#140b2e"/><path d="M0 140L130 760" stroke="#e0469c" stroke-width="3" opacity=".7"/>`;
  g += floor(770, "#ff4fa3");
  g += `<rect class="hbr-floorglow" x="70" y="700" width="470" height="18" fill="#e0469c" opacity=".85" filter="url(#hbr-glow)"/><rect x="70" y="718" width="470" height="52" fill="#2a1c58"/>` + railing(70, 540, 700, 40, 30, "#140b2e", 2.5);
  g += person(300, 700, 0.9, "#c995c4") + holo(318, 640, 46, 28, "chart");
  // drafting console with blueprint holograms
  g += `<polygon points="600,770 640,742 1440,742 1440,900 560,900" fill="#140b2e"/>`;
  g += `<rect x="640" y="702" width="800" height="40" fill="url(#hbr-rail)"/>` + railing(640, 1440, 742, 40, 40, "#140b2e", 3);
  g += person(860, 702, 1.25, "#e9d9c4", true) + person(1010, 702, 1.25, "#e9d9c4");
  g += holo(700, 610, 140, 64, "arch", -8) + holo(1040, 604, 140, 64, "dome", 8) + holo(1210, 630, 70, 40, "chart");
  g += ledge(61, 180, 350);
  return g;
}

holoN = 0;
export const MISSION_SVG = buildMission();
export const ADVANTAGES_SVG = buildAdv();

/** World-space placement (art.tsx): 1440-wide scene scaled to the 1600 world. */
export const CHAMBER_SCALE = 1600 / VW;
/** x (in 1440 scene units) of the water each chamber receives / releases. */
export const MISSION_FALL = { x: 585, w: 160 } as const;
export const ADV_FALL = { x: 190, w: 150 } as const;
