"use client";

import Link from "next/link";
import { Oswald } from "next/font/google";
import {
  createContext,
  useCallback,
  useContext,
  useEffect,
  useMemo,
  useRef,
  useState,
} from "react";
import {
  motion,
  useMotionValue,
  useMotionValueEvent,
  useReducedMotion,
  useScroll,
  useSpring,
  useTransform,
  type MotionValue,
} from "framer-motion";
import {
  CaveSunset,
  ForeLayer,
  SCENE_CENTERS,
  SkyLayer,
  WORLD_H,
  WORLD_W,
  WorldDefs,
  WorldLayer,
} from "./art";
import { SmoothScroll } from "./SmoothScroll";

/** condensed display face for the hero wordmark, as in the reference */
const wordmarkFont = Oswald({ subsets: ["latin"], weight: ["500", "600"], display: "swap" });

const clamp = (n: number, a = 0, b = 1) => Math.min(b, Math.max(a, n));
const easeOut = (x: number) => 1 - Math.pow(1 - x, 3);
const EASE = [0.16, 1, 0.3, 1] as const;

/** Parallax depth of each layer (1 = moves with the world). */
const DEPTH = { sky: 0.6, cave: 0.62, fore: 1.35 } as const;

/* ------------------------------------------------------------------ panels */

/** Visibility (0‥1) of the panel we're inside — drives staggered children. */
const PanelT = createContext<MotionValue<number> | null>(null);

/** A text panel that fades in/out as the world scrolls past its scene. */
function Panel({
  progress,
  at,
  unitsPerP,
  className = "",
  holdAfter = false,
  holdBefore = false,
  children,
}: {
  progress: MotionValue<number>;
  /** scroll progress (0‥1) at which this scene is centred */
  at: number;
  /** world units travelled per 1.0 of progress */
  unitsPerP: number;
  className?: string;
  holdAfter?: boolean;
  holdBefore?: boolean;
  children: React.ReactNode;
}) {
  const t = useMotionValue(0);
  const dir = useMotionValue(1);

  const update = useCallback(
    (v: number) => {
      const signed = (v - at) * unitsPerP;
      let d = Math.abs(signed);
      if (holdAfter && signed > 0) d = 0;
      if (holdBefore && signed < 0) d = 0;
      t.set(clamp(1 - (d - 150) / 300));
      dir.set(signed < 0 ? 1 : -1);
    },
    [at, unitsPerP, holdAfter, holdBefore, t, dir]
  );

  useMotionValueEvent(progress, "change", update);
  useEffect(() => update(progress.get()), [update, progress]);

  // the frame appears quickly; children then stagger in on top of it
  const opacity = useTransform(t, (v) => clamp(v * 3));
  const y = useTransform(() => (1 - t.get()) * 30 * dir.get());
  const pointer = useTransform(t, (o) => (o > 0.5 ? "auto" : "none"));

  return (
    <PanelT.Provider value={t}>
      <motion.div
        style={{ opacity, y, pointerEvents: pointer }}
        className={`absolute ${className}`}
      >
        {children}
      </motion.div>
    </PanelT.Provider>
  );
}

/**
 * One staggered line inside a Panel. `mask` slides the content up from
 * behind a clip edge (for headings); otherwise it rises and fades.
 */
function Item({
  i = 0,
  mask = false,
  as = "div",
  className = "",
  children,
}: {
  i?: number;
  mask?: boolean;
  as?: "div" | "li";
  className?: string;
  children: React.ReactNode;
}) {
  const ctx = useContext(PanelT);
  const fallback = useMotionValue(1);
  const t = ctx ?? fallback;
  const local = useTransform(t, (v) => easeOut(clamp((v - i * 0.085) / 0.5)));
  const opacity = useTransform(local, (l) => (mask ? clamp(l * 1.6) : l));
  const y = useTransform(local, (l) => (mask ? `${(1 - l) * 105}%` : `${(1 - l) * 22}px`));

  if (mask) {
    return (
      <div className={`overflow-hidden pb-[0.12em] ${className}`}>
        <motion.div style={{ y, opacity }}>{children}</motion.div>
      </div>
    );
  }
  const Tag = as === "li" ? motion.li : motion.div;
  return (
    <Tag style={{ y, opacity }} className={className}>
      {children}
    </Tag>
  );
}

function Eyebrow({ children }: { children: React.ReactNode }) {
  const ctx = useContext(PanelT);
  const fallback = useMotionValue(1);
  const t = ctx ?? fallback;
  const scaleX = useTransform(t, (v) => easeOut(clamp(v / 0.6)));
  return (
    <Item i={0}>
      <div
        className="mb-4 flex items-center gap-3 font-mono text-[11px] font-bold uppercase tracking-[0.32em]"
        style={{ color: "var(--accent-text)" }}
      >
        <motion.span
          className="block h-px w-8 origin-left"
          style={{ scaleX, background: "var(--accent)" }}
        />
        {children}
      </div>
    </Item>
  );
}

/** Hero wordmark — letters rise out of a blur one after another on load. */
function IntroWordmark({ text, still }: { text: string; still: boolean }) {
  return (
    <h1
      aria-label={text}
      className={`${wordmarkFont.className} m-0 flex pl-[0.5em] text-[clamp(38px,8.6vw,124px)] font-semibold uppercase leading-none tracking-[0.5em] drop-shadow-[0_6px_30px_rgba(60,20,90,0.45)]`}
    >
      {text.split("").map((ch, i) => (
        <motion.span
          key={i}
          aria-hidden
          className="inline-block"
          initial={still ? false : { opacity: 0, y: "0.55em", filter: "blur(14px)" }}
          animate={{ opacity: 1, y: "0em", filter: "blur(0px)" }}
          transition={{ duration: 1.1, delay: 0.35 + i * 0.075, ease: EASE }}
        >
          {ch}
        </motion.span>
      ))}
    </h1>
  );
}

const textCard =
  "hb-card relative w-[min(440px,calc(100vw-40px))] text-[#f6f1ff] max-md:rounded-2xl max-md:border max-md:border-white/10 max-md:bg-[#0d0a22]/70 max-md:p-6 max-md:backdrop-blur-xl";

/* ------------------------------------------------------------------- story */

export function HeritageStory() {
  const sectionRef = useRef<HTMLElement>(null);
  const reduce = useReducedMotion() ?? false;
  const [size, setSize] = useState({ vw: 1440, vh: 900 });

  useEffect(() => {
    const measure = () =>
      setSize({ vw: window.innerWidth, vh: window.innerHeight });
    measure();
    window.addEventListener("resize", measure);
    return () => window.removeEventListener("resize", measure);
  }, []);

  const geo = useMemo(() => {
    const { vw, vh } = size;
    const s = Math.max(vw / WORLD_W, vh / 1250);
    const worldPxW = WORLD_W * s;
    const worldPxH = WORLD_H * s;
    const travel = Math.max(1, worldPxH - vh);
    const viewUnits = vh / s;
    const unitsPerP = WORLD_H - viewUnits;
    const at = SCENE_CENTERS.map((c) =>
      clamp((c - viewUnits / 2) / unitsPerP)
    );
    return {
      s,
      worldPxW,
      worldPxH,
      offsetX: (vw - worldPxW) / 2,
      travel,
      sectionH: vh + travel,
      unitsPerP,
      at,
    };
  }, [size]);

  const { scrollYProgress } = useScroll({
    target: sectionRef,
    offset: ["start start", "end end"],
  });

  // The camera glides after the scrollbar instead of snapping to it —
  // the weighty, cinematic drift of the reference.
  const glide = useSpring(scrollYProgress, {
    stiffness: 160,
    damping: 32,
    mass: 0.45,
    restDelta: 0.00005,
  });
  const progress = reduce ? scrollYProgress : glide;

  const worldY = useMotionValue(0);
  const skyY = useMotionValue(0);
  const caveY = useMotionValue(0);
  const foreY = useMotionValue(0);

  const apply = useCallback(
    (v: number) => {
      const T = geo.travel;
      worldY.set(-v * T);
      skyY.set(-v * T * DEPTH.sky);
      // anchored at the end (v = 1) where the cave view is composed
      caveY.set(-v * T + (v - 1) * T * (1 - DEPTH.cave));
      // anchored mid-journey so motes spread evenly
      foreY.set(-v * T + (v - 0.5) * T * (1 - DEPTH.fore));

    },
    [geo, worldY, skyY, caveY, foreY]
  );
  useMotionValueEvent(progress, "change", apply);
  useEffect(() => apply(progress.get()), [apply, progress]);

  const barScale = useTransform(progress, [0, 1], [0, 1]);

  // SMIL animations in the chambers ignore CSS — pause them for reduced motion
  useEffect(() => {
    if (!reduce) return;
    sectionRef.current
      ?.querySelectorAll("svg")
      .forEach((svg) => (svg as SVGSVGElement).pauseAnimations?.());
  }, [reduce]);

  const layer = (y: MotionValue<number>) => ({
    position: "absolute" as const,
    top: 0,
    left: geo.offsetX,
    y,
  });

  return (
    <section
      id="story"
      ref={sectionRef}
      style={{ height: geo.sectionH }}
      className="relative bg-[#0d0820]"
    >
      <SmoothScroll />
      <div className="sticky top-0 h-dvh w-full overflow-hidden">
        {/* ---- the world: four parallax depths sharing one coordinate space */}
        <motion.div
          className="absolute inset-0"
          style={{ transformOrigin: "50% 35%" }}
          initial={reduce ? false : { scale: 1.12, opacity: 0 }}
          animate={{ scale: 1, opacity: 1 }}
          transition={{ duration: 2.2, ease: EASE }}
        >
          <motion.svg
            aria-hidden
            viewBox={`0 0 ${WORLD_W} ${WORLD_H}`}
            width={geo.worldPxW}
            height={geo.worldPxH}
            style={{ ...layer(skyY), overflow: "visible" }}
            className="pointer-events-none"
          >
            <WorldDefs />
            <SkyLayer />
          </motion.svg>
          <motion.svg
            aria-hidden
            viewBox={`0 0 ${WORLD_W} ${WORLD_H}`}
            width={geo.worldPxW}
            height={geo.worldPxH}
            style={{ ...layer(caveY), overflow: "visible" }}
            className="pointer-events-none"
          >
            <CaveSunset />
          </motion.svg>
          <motion.svg
            aria-hidden
            viewBox={`0 0 ${WORLD_W} ${WORLD_H}`}
            width={geo.worldPxW}
            height={geo.worldPxH}
            style={layer(worldY)}
            className="pointer-events-none"
          >
            <WorldLayer />
          </motion.svg>
          <motion.svg
            aria-hidden
            viewBox={`0 0 ${WORLD_W} ${WORLD_H}`}
            width={geo.worldPxW}
            height={geo.worldPxH}
            style={{ ...layer(foreY), overflow: "visible" }}
            className="pointer-events-none"
          >
            <ForeLayer />
          </motion.svg>
        </motion.div>

        {/* cinematic vignette + legibility scrim so the nav always reads */}
        <div className="hb-vignette pointer-events-none absolute inset-0" />
        <div className="pointer-events-none absolute inset-x-0 top-0 h-28 bg-gradient-to-b from-[#0d0a22]/55 to-transparent" />

        {/* ---- copy */}
        <div className="absolute inset-0">
          {/* 0 · hero */}
          <Panel
            progress={progress}
            at={geo.at[0]}
            unitsPerP={geo.unitsPerP}
            holdBefore
            className="inset-x-0 top-[13dvh] flex flex-col items-center px-5 text-center text-white"
          >
            <IntroWordmark text="Heritage" still={reduce} />
            <motion.p
              className="wordmark mt-5 text-[clamp(10px,1.25vw,16px)] font-medium tracking-[0.5em] text-white/70"
              initial={reduce ? false : { opacity: 0, letterSpacing: "1.1em" }}
              animate={{ opacity: 1, letterSpacing: "0.5em" }}
              transition={{ duration: 1.6, delay: 1.1, ease: EASE }}
            >
              Buildings, remembered
            </motion.p>
          </Panel>

          {/* scroll hint, parked at the bottom so it never sits on the art */}
          <Panel
            progress={progress}
            at={geo.at[0]}
            unitsPerP={geo.unitsPerP}
            holdBefore
            className="inset-x-0 bottom-5 flex justify-center"
          >
            <motion.div
              initial={reduce ? false : { opacity: 0, y: 16 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ duration: 1, delay: 1.8, ease: EASE }}
              className="flex items-center gap-3 rounded-full border border-white/20 bg-black/30 px-4 py-2 font-mono text-[10.5px] uppercase tracking-[0.28em] text-white/80 backdrop-blur-md"
            >
              <span className="relative h-5 w-[1.5px] overflow-hidden bg-white/25">
                <motion.span
                  className="absolute inset-x-0 top-0 h-2 bg-white"
                  animate={{ y: [-8, 20] }}
                  transition={{ duration: 1.6, repeat: Infinity, ease: "easeInOut" }}
                />
              </span>
              Scroll
            </motion.div>
          </Panel>

          {/* 1 · mission (left) */}
          <Panel
            progress={progress}
            at={geo.at[1]}
            unitsPerP={geo.unitsPerP}
            className="bottom-[8dvh] left-5 md:bottom-auto md:left-[7vw] md:top-1/2 md:-translate-y-1/2"
          >
            <div className={textCard}>
              <Eyebrow>01 · Our mission</Eyebrow>
              <Item i={1} mask>
                <h2 className="m-0 mb-5 font-display text-[clamp(32px,4.2vw,56px)] font-semibold leading-[1.02] tracking-[-0.02em]">
                  Our Mission
                </h2>
              </Item>
              <Item i={2}>
                <p className="m-0 mb-4 text-[14.5px] leading-[1.75] text-white/75">
                  We translate the world&apos;s heritage buildings into refined,
                  print-ready 3D models — every cornice, arch and column rebuilt
                  by hand, so history can sit on your shelf.
                </p>
              </Item>
              <Item i={3}>
                <p className="m-0 mb-7 text-[14.5px] leading-[1.75] text-white/75">
                  By mapping and measuring each landmark with care, we keep the
                  proportions honest and the details crisp enough to print.
                </p>
              </Item>
              <Item i={4}>
                <Link
                  href="/studio"
                  className="group inline-flex items-center gap-2 rounded-md border border-white/30 bg-white/95 px-4 py-2 text-[12px] font-semibold text-[#150c34] no-underline transition-transform hover:scale-[1.03]"
                >
                  Learn more
                  <span className="transition-transform duration-300 group-hover:translate-x-1">→</span>
                </Link>
              </Item>
            </div>
          </Panel>

          {/* 2 · advantages (right) */}
          <Panel
            progress={progress}
            at={geo.at[2]}
            unitsPerP={geo.unitsPerP}
            className="bottom-[8dvh] left-5 md:bottom-auto md:left-auto md:right-[7vw] md:top-1/2 md:-translate-y-1/2"
          >
            <div className={textCard}>
              <Eyebrow>02 · Our advantages</Eyebrow>
              <Item i={1} mask>
                <h2 className="m-0 mb-5 font-display text-[clamp(32px,4.2vw,56px)] font-semibold leading-[1.02] tracking-[-0.02em]">
                  Our Advantages
                </h2>
              </Item>
              <Item i={2}>
                <h3 className="m-0 mb-1.5 text-[14px] font-bold text-white">
                  Faithful to the original.
                </h3>
                <p className="m-0 mb-5 text-[14px] leading-[1.7] text-white/70">
                  Archival drawings, site surveys and photogrammetry set the
                  proportions before a single polygon is drawn.
                </p>
              </Item>
              <Item i={3}>
                <h3 className="m-0 mb-1.5 text-[14px] font-bold text-white">
                  Boldly print-ready.
                </h3>
                <p className="m-0 text-[14px] leading-[1.7] text-white/70">
                  Clean, layered parts — walls, roofs, domes, details — tested on
                  Bambu Lab printers and split for multi-colour builds.
                </p>
              </Item>
            </div>
          </Panel>

          {/* 3 · studio (left) */}
          <Panel
            progress={progress}
            at={geo.at[3]}
            unitsPerP={geo.unitsPerP}
            className="bottom-[8dvh] left-5 md:bottom-auto md:left-[7vw] md:top-1/2 md:-translate-y-1/2"
          >
            <div className={textCard}>
              <Eyebrow>03 · The Studio</Eyebrow>
              <Item i={1} mask>
                <h2 className="m-0 mb-5 font-display text-[clamp(30px,3.8vw,52px)] font-semibold leading-[1.04] tracking-[-0.02em]">
                  A Model Built For You
                </h2>
              </Item>
              <Item i={2}>
                <p className="m-0 mb-4 text-[14.5px] leading-[1.75] text-white/75">
                  Pick a landmark, reshape its layers, choose your filament
                  colours, set your printer and download — all in the browser.
                </p>
              </Item>
              <ul className="m-0 mb-0 list-none space-y-2.5 p-0 text-[14px] text-white/80">
                {[
                  "Live 3D preview with transform gizmo",
                  "Per-layer height & visibility controls",
                  "Export multi-colour 3MF or a merged STL",
                ].map((t, k) => (
                  <Item key={t} i={3 + k} as="li" className="flex items-start gap-3">
                    <span
                      className="mt-[9px] h-[5px] w-[5px] shrink-0 rotate-45"
                      style={{ background: "var(--accent)" }}
                    />
                    {t}
                  </Item>
                ))}
              </ul>
            </div>
          </Panel>

          {/* 4 · finale */}
          <Panel
            progress={progress}
            at={geo.at[4]}
            unitsPerP={geo.unitsPerP}
            holdAfter
            className="inset-x-0 bottom-[7dvh] flex justify-center px-5"
          >
            <div className="flex w-[min(560px,100%)] flex-col items-center rounded-3xl border border-white/15 bg-[#0d0a22]/60 px-8 py-8 text-center text-white backdrop-blur-xl">
              <Item i={0} mask>
                <h2 className="m-0 mb-3 font-display text-[clamp(28px,3.6vw,44px)] font-semibold tracking-[-0.02em]">
                  Step inside the Studio.
                </h2>
              </Item>
              <Item i={1}>
                <p className="m-0 mb-6 max-w-[420px] text-[14.5px] leading-[1.7] text-white/75">
                  Choose a landmark and make it yours.
                </p>
              </Item>
              <Item i={2}>
                <div className="flex flex-wrap justify-center gap-3">
                  <Link
                    href="/studio"
                    className="hb-cta relative overflow-hidden rounded-full px-6 py-3 text-[13.5px] font-bold text-[#150c34] no-underline transition-transform hover:scale-[1.04]"
                    style={{ background: "linear-gradient(100deg,#ffd29a,#ff9a5c 55%,#f0709a)" }}
                  >
                    Open the Studio
                  </Link>
                  <Link
                    href="/login"
                    className="rounded-full border border-white/30 px-6 py-3 text-[13.5px] font-medium text-white no-underline transition-colors hover:bg-white/10"
                  >
                    Sign in
                  </Link>
                </div>
              </Item>
            </div>
          </Panel>
        </div>

        {/* progress hairline */}
        <div className="pointer-events-none absolute right-0 top-0 hidden h-full w-[3px] bg-white/[0.06] md:block">
          <motion.div
            className="h-full w-full origin-top"
            style={{
              scaleY: barScale,
              background: "linear-gradient(180deg,#ffd29a,#ff9a5c,#e0589b)",
            }}
          />
        </div>
      </div>
    </section>
  );
}
